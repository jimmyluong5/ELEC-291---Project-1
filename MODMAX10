;--------------------------------------------------------
; Special Function Registers
;--------------------------------------------------------
P0             DATA 0x80 ;standard I/O ports, on the DE10-these are the GPIO pins.(port0)
SP             DATA 0x81 ; stack pointers
DPL            DATA 0x82 ;data pointer low
DPH            DATA 0x83 ;data pointer high
PCON           DATA 0x87 ;power control
TCON           DATA 0x88 ;timer control, contains run control bits TR0 and TR1 and overflow flags( TF0, TF1) for timers 0 and
TMOD           DATA 0x89 ;timer mode, sets the operating mode
TL0            DATA 0x8a ;low byte that hold the count values for timer0 
TL1            DATA 0x8b ;low byte that hold the count values for timer 1
TH0            DATA 0x8c ;high byte that hold the count values for timer0 
TH1            DATA 0x8d ;high byte that hold the count values for timer0 
P1             DATA 0x90 ;standard I/O ports, on the DE10-these are the GPIO pins. (port 1)
SCON           DATA 0x98 ;serial control used for UART communication. (sending/receiving data to PC)
SBUF           DATA 0x99 ;serial buffer used for UART communication. (sending/receiving data to PC)
P2             DATA 0xa0 ;standard I/O ports, on the DE10-these are the GPIO pins. (port 2)
IE             DATA 0xa8 ;interrupt enable used to turn on INTs like (EA for global enable)
P3             DATA 0xb0 ;standard I/O ports, on the DE10-these are the GPIO pins. (port 3)
IP             DATA 0xb8 ;interrupt priority used to determine which INTS are important 
PSW            DATA 0xd0 ;program status word, contains CPU status flags such as CARRY(CY), OVERFLOW(OV)flags
ACC            DATA 0xe0 ;accumulator register, used for arithmetic and logic operations, 
B              DATA 0xf0 ;this register is used for multiplication and division. 
T2CON          DATA 0xc8 ;timer 2 control, manages timer, used for baud rate generation or high precision timing.
RCAP2L         DATA 0xca ;timer 2 reload/capture registers, stores the value to be reloaded into timer2 upon overflow (low)
RCAP2H         DATA 0xcb ;timer 2 reload/capture registers, stores the value to be reloaded into timer2 upon overflow (high)
TL2            DATA 0xcc
TH2            DATA 0xcd
DPS            DATA 0x86
DPH1           DATA 0x85
DPL1           DATA 0x84
HEX0           DATA 0x91 ;data registers for the hex displays for the de10 lite below-------
HEX1           DATA 0x92
HEX2           DATA 0x93
HEX3           DATA 0x94
HEX4           DATA 0x8e
HEX5           DATA 0x8f
LEDRA          DATA 0xe8 ;leds, contains the same address as SWA, writing to SWA also affects the LEDS.
LEDRB          DATA 0x95
SWA            DATA 0xe8 ;contains the state of the SW0-SW7 switches on the DE10-Lite
SWB            DATA 0x95 ;handles SW8-SW9
KEY            DATA 0xf8 ;holds the state of push buttons KEY0-KEY3 (active low)
P0MOD          DATA 0x9a ;port mode registers, this requires you to configure the pins as bidirectional, input, output etc.
P1MOD          DATA 0x9b ;port mode registers, this requires you to configure the pins as bidirectional, input, output etc.
P2MOD          DATA 0x9c ;port mode registers, this requires you to configure the pins as bidirectional, input, output etc.
P3MOD          DATA 0x9d ;port mode registers, this requires you to configure the pins as bidirectional, input, output etc.
REP_ADD_L      DATA 0xf1
REP_ADD_H      DATA 0xf2
REP_VALUE      DATA 0xf3
DEBUG_CALL_L   DATA 0xfa
DEBUG_CALL_H   DATA 0xfb
BPC            DATA 0xfc
BPS            DATA 0xfd
BPAL           DATA 0xfe
BPAH           DATA 0xff
LBPAL          DATA 0xfa
LBPAH          DATA 0xfb
P4             DATA 0xc0 ;standard I/O ports, on the DE10-these are the GPIO pins. (port 4)
P4MOD          DATA 0xc1 ;port mode registers, this requires you to configure the pins as bidirectional, input, output etc.
XRAMUSEDAS     DATA 0xc3
UFM_ADD0       DATA 0xe1 ;user flash memory, used to read or write to the internal flash memory of the FPGA for permanent data storage
UFM_ADD1       DATA 0xe2
UFM_ADD2       DATA 0xe3
UFM_DATA0      DATA 0xe4
UFM_DATA1      DATA 0xe5
UFM_DATA2      DATA 0xe6
UFM_DATA3      DATA 0xe7
UFM_CONTROL0   DATA 0xe9
UFM_CONTROL1   DATA 0xea
UFM_CONTROL2   DATA 0xeb
UFM_CONTROL3   DATA 0xec
UFM_DATA_CMD   DATA 0xed
UFM_DATA_STATUS DATA 0xee
UFM_CONTROL_CMD DATA 0xef
ADC_C          DATA 0xa1 ;analog to digital converter registers, used to read analog voltages below
ADC_L          DATA 0xa2
ADC_H          DATA 0xa3

