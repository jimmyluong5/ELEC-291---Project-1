; ISR_example.asm: a) Increments/decrements a BCD variable every half second using
; an ISR for timer 2; b) Generates a 2kHz square wave at pin P1.7 using
; an ISR for timer 0; and c) in the 'main' loop it displays the variable
; incremented/decremented using the ISR for timer 2 on the LCD.  Also resets it to 
; zero if the 'CLEAR' push button connected to P1.5 is pressed.
$NOLIST
$MODN76E003
$LIST

;  N76E003 pinout:
;                               -------
;       PWM2/IC6/T0/AIN4/P0.5 -|1    20|- P0.4/AIN5/STADC/PWM3/IC3
;               TXD/AIN3/P0.6 -|2    19|- P0.3/PWM5/IC5/AIN6
;               RXD/AIN2/P0.7 -|3    18|- P0.2/ICPCK/OCDCK/RXD_1/[SCL]
;                    RST/P2.0 -|4    17|- P0.1/PWM4/IC4/MISO
;        INT0/OSCIN/AIN1/P3.0 -|5    16|- P0.0/PWM3/IC3/MOSI/T1
;              INT1/AIN0/P1.7 -|6    15|- P1.0/PWM2/IC2/SPCLK
;                         GND -|7    14|- P1.1/PWM1/IC1/AIN7/CLO
;[SDA]/TXD_1/ICPDA/OCDDA/P1.6 -|8    13|- P1.2/PWM0/IC0
;                         VDD -|9    12|- P1.3/SCL/[STADC]
;            PWM5/IC7/SS/P1.5 -|10   11|- P1.4/SDA/FB/PWM1
;                               -------
;

CLK           EQU 16600000 ; Microcontroller system frequency in Hz
TIMER0_RATE   EQU 4096     ; 2048Hz squarewave (peak amplitude of CEM-1203 speaker)
TIMER0_RELOAD EQU ((65536-(CLK/TIMER0_RATE)))
TIMER2_RATE   EQU 1000     ; 1000Hz, for a timer tick of 1ms
TIMER2_RELOAD EQU ((65536-(CLK/TIMER2_RATE)))

AM_PM_TOGGLE equ P1.0
HOURS_TOGGLE equ P1.1
MINUTES_TOGGLE equ P1.6
SECONDS_TOGGLE equ P0.5
TIME_ALARM_TOGGLE  equ P1.5
SOUND_OUT     equ P1.7

; Reset vector
org 0x0000
    ljmp main

; External interrupt 0 vector (not used in this code)
org 0x0003
	reti

; Timer/Counter 0 overflow interrupt vector
org 0x000B
	ljmp Timer0_ISR

; External interrupt 1 vector (not used in this code)
org 0x0013
	reti

; Timer/Counter 1 overflow interrupt vector (not used in this code)
org 0x001B
	reti

; Serial port receive/transmit interrupt vector (not used in this code)
org 0x0023 
	reti
	
; Timer/Counter 2 overflow interrupt vector
org 0x002B
	ljmp Timer2_ISR

; In the 8051 we can define direct access variables starting at location 0x30 up to location 0x7F
dseg at 0x30
Count1ms:     ds 2 ; Used to determine when half second has passed
seconds:  ds 1 ; The BCD counter incrememted in the ISR and displayed in the main loop
minutes:  ds 1
hours:  ds 1
am_pm: ds 1
alarm_minutes: ds 1
alarm_hours: ds 1
alarm_am_pm: ds 1
alarm_state: ds 1
time_alarm: ds 1

; In the 8051 we have variables that are 1-bit in size.  We can use the setb, clr, jb, and jnb
; instructions with these variables.  This is how you define a 1-bit variable:
bseg
seconds_flag: dbit 1 ; Set to one in the ISR every time 500 ms had passed

cseg
; These 'equ' must match the hardware wiring
LCD_RS equ P1.3
;LCD_RW equ PX.X ; Not used in this code, connect the pin to GND
LCD_E  equ P1.4
LCD_D4 equ P0.0
LCD_D5 equ P0.1
LCD_D6 equ P0.2
LCD_D7 equ P0.3

$NOLIST
$include(LCD_4bit.inc) ; A library of LCD related functions and utility macros
$LIST

;                     1234567890123456    <- This helps determine the location of the counter

Initial_Message1: db  'Time    :  :', 0
Initial_Message2: db  'Alarm   :', 0

;---------------------------------;
; Routine to initialize the ISR   ;
; for timer 0                     ;
;---------------------------------;
Timer0_Init:
	orl CKCON, #0b00001000 ; Input for timer 0 is sysclk/1
	mov a, TMOD
	anl a, #0xf0 ; 11110000 Clear the bits for timer 0
	orl a, #0x01 ; 00000001 Configure timer 0 as 16-timer
	mov TMOD, a
	mov TH0, #high(TIMER0_RELOAD)
	mov TL0, #low(TIMER0_RELOAD)
	; Enable the timer and interrupts
    setb ET0  ; Enable timer 0 interrupt
    setb TR0  ; Start timer 0
	ret

;---------------------------------;
; ISR for timer 0.  Set to execute;
; every 1/4096Hz to generate a    ;
; 2048 Hz wave at pin SOUND_OUT   ;
;---------------------------------;
Timer0_ISR:
	;clr TF0  ; According to the data sheet this is done for us already.
	; Timer 0 doesn't have 16-bit auto-reload, so
	;Compare time with alarm time
	clr TR0
	mov TH0, #high(TIMER0_RELOAD)
	mov TL0, #low(TIMER0_RELOAD)
	setb TR0
	cpl SOUND_OUT ; Connect speaker the pin assigned to 'SOUND_OUT'!
	reti
;---------------------------------;
; Routine to initialize the ISR   ;
; for timer 2                     ;
;---------------------------------;
Timer2_Init:
	mov T2CON, #0 ; Stop timer/counter.  Autoreload mode.
	mov TH2, #high(TIMER2_RELOAD)
	mov TL2, #low(TIMER2_RELOAD)
	; Set the reload value
	orl T2MOD, #0x80 ; Enable timer 2 autoreload
	mov RCMP2H, #high(TIMER2_RELOAD)
	mov RCMP2L, #low(TIMER2_RELOAD)
	; Init One millisecond interrupt counter.  It is a 16-bit variable made with two 8-bit parts
	clr a
	mov Count1ms+0, a
	mov Count1ms+1, a
	; Enable the timer and interrupts
	orl EIE, #0x80 ; Enable timer 2 interrupt ET2=1
    setb TR2  ; Enable timer 2
	ret

;---------------------------------;
; ISR for timer 2                 ;
;---------------------------------;
Timer2_ISR:
	clr TF2  ; Timer 2 doesn't clear TF2 automatically. Do it in the ISR.  It is bit addressable.
	cpl P0.4 ; To check the interrupt rate with oscilloscope. It must be precisely a 1 ms pulse.
	
	; The two registers used in the ISR must be saved in the stack
	push acc
	push psw
	
	; Increment the 16-bit one mili second counter
	inc Count1ms+0    ; Increment the low 8-bits first
	mov a, Count1ms+0 ; If the low 8-bits overflow, then increment high 8-bits
	jnz Inc_Done
	inc Count1ms+1

Inc_Done:
	; Check if half second has passed
	mov a, am_pm
	cjne a, alarm_am_pm, nah
	mov a, hours
	cjne a, alarm_hours, nah
	mov a, minutes
	cjne a, alarm_minutes, nah
	mov a, alarm_state
	cjne a, #1, nah
	setb ET0
	sjmp next
	nah:
	clr ET0
	next:
	mov a, Count1ms+0
	cjne a, #low(1000), Timer2_ISR_done ; Warning: this instruction changes the carry flag!
	mov a, Count1ms+1
	cjne a, #high(1000), Timer2_ISR_done
	; 500 milliseconds have passed.  Set a flag so the main program knows
	setb seconds_flag ; Let the main program know half second had passed
	cpl TR0 ; Enable/disable timer/counter 0. This line creates a beep-silence-beep-silence sound.
	; Reset to zero the milli-seconds counter, it is a 16-bit variable
	clr a
	mov Count1ms+0, a
	mov Count1ms+1, a
	
	jnb TIME_ALARM_TOGGLE, select
	selector:
	mov a, time_alarm
	cjne a, #1, time
	sjmp alarm
select:
	mov a, time_alarm
	cjne a, #1, to_1
	mov time_alarm, #0
	sjmp selector
	to_1:
	mov time_alarm, #1
	sjmp selector
alarm:
	; Increment the BCD counter
	mov a, seconds
	cjne a, #0x59, notEqSec
	ljmp overflow_seconds
	notEqSec:
	add a, #0x01
	jnb SECONDS_TOGGLE, switch_alarm
	jnb MINUTES_TOGGLE, alarm_min_increment
	jnb HOURS_TOGGLE, alarm_hr_increment
	jnb AM_PM_TOGGLE, alarm_change_am_pm
	ljmp Timer2_ISR_da_sec
Timer2_ISR_done:
	pop psw
	pop acc
	reti
switch_alarm:
	mov a, alarm_state
	cjne a, #1, turn_on
	mov alarm_state, #0
	sjmp Timer2_ISR_done
	turn_on:
	mov alarm_state, #1
	sjmp Timer2_ISR_done
alarm_min_increment:
	mov a, alarm_minutes
	cjne a, #0x59, cont8
	mov a, #0x0
	sjmp alarm_Timer2_ISR_da_min
	cont8:
	add a, #0x1
	sjmp alarm_Timer2_ISR_da_min
alarm_hr_increment:
	mov a, alarm_hours
	cjne a, #0x12, cont9
	sjmp alarm_overflow_in_hours
	cont9:
	add a, #0x1
	sjmp alarm_Timer2_ISR_da_hr
alarm_overflow_in_hours:
	mov alarm_hours, #0x1
	ljmp Timer2_ISR_done
alarm_change_am_pm:
	mov a, alarm_am_pm
	cjne a, #'A', toAM2
	mov a, #'P'
	mov alarm_am_pm, a
	ljmp Timer2_ISR_done
	toAM2:
	mov a, #'A'
	mov alarm_am_pm, a
	ljmp Timer2_ISR_done
alarm_Timer2_ISR_da_min:
	da a ; Decimal adjust instruction.  Check datasheet for more details!
	mov alarm_minutes, a
	ljmp Timer2_ISR_done
alarm_Timer2_ISR_da_hr:
	da a ; Decimal adjust instruction.  Check datasheet for more details!
	mov alarm_hours, a
	ljmp Timer2_ISR_done
	
time:
	; Increment the BCD counter
	mov a, seconds
	jnb SECONDS_TOGGLE, Timer2_ISR_decrement
	cjne a, #0x59, notEqSec2
	sjmp overflow_seconds
	notEqSec2:
	add a, #0x01
	jnb MINUTES_TOGGLE, min_increment
	jnb HOURS_TOGGLE, hr_increment
	jnb AM_PM_TOGGLE, change_am_pm
	sjmp Timer2_ISR_da_sec
min_increment:
	mov a, minutes
	cjne a, #0x59, cont7
	mov a, #0x0
	sjmp Timer2_ISR_da_min
	cont7:
	add a, #0x1
	sjmp Timer2_ISR_da_min
hr_increment:
	mov a, hours
	cjne a, #0x12, cont3
	sjmp overflow_in_hours
	cont3:
	add a, #0x1
	sjmp Timer2_ISR_da_hr
overflow_seconds:
	mov seconds, #0
	mov a, minutes
	cjne a, #0x59, notEqMin
	sjmp overflow_hours
	notEqMin:
	add a, #0x01
	mov minutes, a
	ljmp Timer2_ISR_done
overflow_hours:
	mov minutes, #0
	mov a, hours
	cjne a, #0x11, notEqHr1
	sjmp overflow_am_pm
	notEqHr1:
	cjne a, #0x12, notEqHr2
	sjmp overflow_in_hours
	notEqHr2:
	add a, #0x01
	mov hours, a
	ljmp Timer2_ISR_done
overflow_am_pm:
	mov hours, #0x12
	change_am_pm:
	mov a, am_pm
	cjne a, #'A', toAM
	mov a, #'P'
	mov am_pm, a
	ljmp Timer2_ISR_done
	toAM:
	mov a, #'A'
	mov am_pm, a
	ljmp Timer2_ISR_done
overflow_in_hours:
	mov hours, #0x1
	ljmp Timer2_ISR_done
Timer2_ISR_decrement:
	cjne a, #0x0, cont6
	mov a, #0x59
	sjmp Timer2_ISR_da_sec
	cont6:
	add a, #0x99 ; Adding the 10-complement of -1 is like subtracting 1.
	sjmp Timer2_ISR_da_sec
Timer2_ISR_da_sec:
	da a ; Decimal adjust instruction.  Check datasheet for more details!
	mov seconds, a
	ljmp Timer2_ISR_done
Timer2_ISR_da_min:
	da a ; Decimal adjust instruction.  Check datasheet for more details!
	mov minutes, a
	ljmp Timer2_ISR_done
Timer2_ISR_da_hr:
	da a ; Decimal adjust instruction.  Check datasheet for more details!
	mov hours, a
	ljmp Timer2_ISR_done
	

;---------------------------------;
; Main program. Includes hardware ;
; initialization and 'forever'    ;
; loop.                           ;
;---------------------------------;
main:
	; Initialization
    mov SP, #0x7F
    mov P0M1, #0x00
    mov P0M2, #0x00
    mov P1M1, #0x00
    mov P1M2, #0x00
    mov P3M2, #0x00
    mov P3M2, #0x00
        
    mov seconds, #0x50
	mov minutes, #0x54
	mov hours, #0x11
	mov am_pm, #'P'
	mov alarm_minutes, #0x55
	mov alarm_hours, #0x11
	mov alarm_am_pm, #'A'
	mov alarm_state, #0
	mov time_alarm, #0
      
    lcall Timer0_Init
    lcall Timer2_Init
    setb EA   ; Enable Global interrupts
    clr ET0   
    lcall LCD_4BIT
    ; For convenience a few handy macros are included in 'LCD_4bit.inc':
	Set_Cursor(1, 1)
    Send_Constant_String(#Initial_Message1)
    Set_Cursor(2, 1)
    Send_Constant_String(#Initial_Message2)
    setb seconds_flag
	
	; After initialization the program stays in this 'forever' loop

loop:
    clr seconds_flag ; We clear this flag in the main loop, but it is set in the ISR for timer 2
	Set_Cursor(1, 15)
	Display_Char(am_pm)
	Set_Cursor(1, 13)     ; the place in the LCD where we want the BCD counter value
	Display_BCD(seconds) ; This macro is also in 'LCD_4bit.inc'
	Set_Cursor(1, 10)
	Display_BCD(minutes)
	Set_Cursor(1, 7)
	Display_BCD(hours)
	Set_Cursor(2, 12)
	Display_Char(alarm_am_pm)
	Set_Cursor(2, 10)
	Display_BCD(alarm_minutes)
	Set_Cursor(2, 7)
	Display_BCD(alarm_hours)
	mov a, time_alarm
	cjne a, #1, time_display
	Set_Cursor(2, 6)
	Display_Char(#'>')
	Set_Cursor(1, 6)
	Display_Char(#' ')
	sjmp cont10
	time_display:
	Set_Cursor(1, 6)
	Display_Char(#'>')
	Set_Cursor(2, 6)
	Display_Char(#' ')
	cont10:
	
	mov a, alarm_state
	cjne a, #1, alarm_off
	alarm_on:
		Set_Cursor(2, 14)
		Display_Char(#'O')
		Set_Cursor(2, 15)
		Display_Char(#'n')
		Set_Cursor(2, 16)
		Display_Char(#' ')
		ljmp loop
	alarm_off:
		Set_Cursor(2, 14)
		Display_Char(#'O')
		Set_Cursor(2, 15)
		Display_Char(#'f')
		Set_Cursor(2, 16)
		Display_Char(#'f')
    	ljmp loop
END
