;=========================================================
; RUN DISPLAY line 2: temperature "T:xxx"
;=========================================================
LCD_ShowTempLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#temp_lbl)

    lcall Bin16_To_3Digits
    mov a, R0
    lcall WriteDigitA
    mov a, R1
    lcall WriteDigitA
    mov a, R2
    lcall WriteDigitA
    ret


;=========================================================
; RUN DISPLAY line 2: duty "PWM:xxx%"
;=========================================================
LCD_ShowDutyLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#duty_lbl)

    ; Convert PWM_duty (0..100) to digits R0,R1,R2
    clr a
    mov R0, a
    mov R1, a
    mov R2, a

    mov a, PWM_duty
    cjne a, #100, DUT_not100
    mov R0, #1
    mov R1, #0
    mov R2, #0
    sjmp DUT_print

DUT_not100:
    mov b, #10
    div ab            ; A=tens, B=units
    mov R1, a
    mov R2, b
    mov R0, #0

DUT_print:
    ; print " xx" or "100"
    mov a, R0
    jnz DUT_pH
    WriteData(#' ')
    sjmp DUT_pT
DUT_pH:
    lcall WriteDigitA

DUT_pT:
    mov a, R1
    jnz DUT_pTshow
    mov a, R0
    jnz DUT_pTshow
    WriteData(#' ')
    sjmp DUT_pU
DUT_pTshow:
    mov a, R1
    lcall WriteDigitA

DUT_pU:
    mov a, R2
    lcall WriteDigitA

    Send_Constant_String(#pct_lbl)
    ret


;=========================================================
; Display_Status_All
; - always: HEX shows oven_temp
; - when running:
;      line1 state title
;      line2 temp (SW5=0) or duty (SW5=1)
;=========================================================
Display_Status_All:
    lcall HEX_Show_OvenTemp

    mov a, run_flag
    jz DSA_done

    lcall LCD_ShowStateTitle

    jb SW5, DSA_duty
    lcall LCD_ShowTempLine2
    sjmp DSA_done
DSA_duty:
    lcall LCD_ShowDutyLine2

DSA_done:
    ret


;=========================================================
; DEBUG: Fake temperature generator (updates once per second)
;=========================================================
Fake_OvenTemp_Update:
    ; only update right after 1-second rollover (ms_count == 0)
    mov a, ms_count+0
    orl a, ms_count+1
    jnz FOT_done

    ; not running: drift toward 25C
    mov a, run_flag
    jnz FOT_running

FOT_idle:
    ; if oven_temp == 25 do nothing
    mov a, oven_temp+0
    cjne a, #25, FOT_idle_checkdir
    mov a, oven_temp+1
    cjne a, #0,  FOT_idle_checkdir
    sjmp FOT_done

FOT_idle_checkdir:
    ; if oven_temp >= 25 cool by 1 else heat by 1
    mov target16+0, #25
    mov target16+1, #0
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FOT_idle_cool
    lcall Temp_Add1
    sjmp FOT_clamp
FOT_idle_cool:
    lcall Temp_Sub1
    sjmp FOT_clamp

FOT_running:
    mov a, PWM_duty
    jz FOT_cool_fast

    ; duty >= 60 => +6
    mov a, PWM_duty
    clr c
    subb a, #60
    jc FOT_heat_med
    lcall Temp_Add6
    sjmp FOT_clamp

FOT_heat_med:
    ; duty >= 30 => +3
    mov a, PWM_duty
    clr c
    subb a, #30
    jc FOT_heat_low
    lcall Temp_Add3
    sjmp FOT_clamp

FOT_heat_low:
    ; duty 1..29 => +1
    lcall Temp_Add1
    sjmp FOT_clamp

FOT_cool_fast:
    ; duty == 0 => -4
    lcall Temp_Sub4

FOT_clamp:
    ; clamp upper to 300
    mov target16+0, #LOW(300)
    mov target16+1, #HIGH(300)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FOT_done
    mov oven_temp+0, #LOW(300)
    mov oven_temp+1, #HIGH(300)

FOT_done:
    ret


;=========================================================
; TEMP helpers (16-bit unsigned oven_temp)
;=========================================================
Temp_Add1:
    inc oven_temp+0
    mov a, oven_temp+0
    jnz TA1_done
    inc oven_temp+1
TA1_done:
    ret

Temp_Add3:
    lcall Temp_Add1
    lcall Temp_Add1
    lcall Temp_Add1
    ret

Temp_Add6:
    lcall Temp_Add3
    lcall Temp_Add3
    ret

Temp_Sub1:
    ; if oven_temp == 0 => stay 0
    mov a, oven_temp+0
    orl a, oven_temp+1
    jz TS1_done
    dec oven_temp+0
    mov a, oven_temp+0
    cjne a, #0FFh, TS1_done
    dec oven_temp+1
TS1_done:
    ret

Temp_Sub4:
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    ret


;=========================================================
; HANDLE KEYPAD INPUT (R7 keycode)
; - Running: only Start/Stop key is acted on; other keys ignored
; - Not running: normal editing works (* # digits) + Start/Stop works
;=========================================================
Handle_Key:
    mov a, R7

    ; START/STOP (Row4 Col4)
    cjne a, #KEY_START_BTN, HK_not_start

    mov a, run_flag
    xrl a, #1
    mov run_flag, a

    ; turning ON?
    jz HK_stopped
    mov state, #1
    clr a
    mov seconds+0, a
    mov seconds+1, a
    lcall LCD_Clear          ; wipe PROFILE READY / edit UI
    ret

HK_stopped:
    ; stop manually -> idle + heater off
    mov state, #0
    lcall Set_PWM_Off
    ret

HK_not_start:
    ; if running, ignore everything else
    mov a, run_flag
    jnz HK_done

    ; ENTER (*)
    mov a, R7
    cjne a, #KEY_STAR, HK_clear
    jb duty_mode, HK_save_duty

    lcall Save_Param

    mov a, param_index
    cjne a, #4, HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_save_duty:
    lcall Save_Duty
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    ; CLEAR (#)
    mov a, R7
    cjne a, #KEY_POUND, HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    ; accept only 0..9
    mov a, R7
    cjne a, #0Ah, HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_done:
    ret


;=========================================================
; MAIN
;=========================================================
main:
    mov SP,#7Fh

    ; set the pins to output (your original)
    mov P0MOD,#10101111b
    mov P1MOD,#10000010b
    mov P2MOD,#10000010b

    ; defaults
    clr a
    mov param_index,a
    clr duty_mode

    mov state, #0
    mov run_flag, #0

    ; start fake temp at room temp 25C
    mov oven_temp+0, #25
    mov oven_temp+1, #0

    lcall Clear_Input
    lcall Configure_Keypad_Pins

    lcall Timer0_Init
    lcall Timer2_Init

    setb PWM
    setb EA

    lcall ELCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    ;=====================================================
    ; UI mode selection ONLY when NOT running
    ; - SW5 selects DUTY EDIT vs PARAM pages
    ;=====================================================
    mov a, run_flag
    jnz SKIP_UI_MODE

    jb SW5, SW5_ON

SW5_OFF:
    jb duty_mode, MODE_TO_PARAM
    sjmp SW5_DONE
MODE_TO_PARAM:
    clr duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    sjmp SW5_DONE

SW5_ON:
    jnb duty_mode, MODE_TO_DUTY
    sjmp SW5_DONE
MODE_TO_DUTY:
    setb duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput

SW5_DONE:
SKIP_UI_MODE:

    ;=====================================================
    ; Keypad
    ;=====================================================
    lcall Keypad
    jnc NO_KEY
    lcall Handle_Key
NO_KEY:

    ;=====================================================
    ; TEMP + FSM + DISPLAY
    ;=====================================================
    lcall Fake_OvenTemp_Update      ; replace later with real temp update
    lcall FSM_Control
    lcall Display_Status_All

    sjmp loop

END
