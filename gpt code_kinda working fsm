LCD_ShowStateTitle:
    mov a, state
    cjne a, #0, SST1
    Set_Cursor(1,1)
    Send_Constant_String(#s_idle)
    ret
SST1:
    cjne a, #1, SST2
    Set_Cursor(1,1)
