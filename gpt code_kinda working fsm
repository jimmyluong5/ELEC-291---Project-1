Return_To_Menu:
    mov run_flag,#0
    clr paused_flag
    mov state,#0
    clr error_demo_flag
    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    clr duty_mode
    mov param_index,#0
    lcall Set_PWM_Off
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
