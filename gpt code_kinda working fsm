RunTime_To_3Digits:
    ; tmp16 = run_time
    mov tmp16+0, run_time+0
    mov tmp16+1, run_time+1

    clr a
    mov R4,a   ; hundreds
    mov R5,a   ; tens
    mov R6,a   ; ones

RT_h:
    mov target16+0,#100
    mov target16+1,#0
    lcall GE16
    jnc RT_t
    mov a,tmp16+0
    clr c
    subb a,#100
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R4
    sjmp RT_h

RT_t:
    mov target16+0,#10
    mov target16+1,#0
    lcall GE16
    jnc RT_u
    mov a,tmp16+0
    clr c
    subb a,#10
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R5
    sjmp RT_t

RT_u:
    mov R6,tmp16+0
    ret

