$NOLIST
$MODMAX10
$LIST

;=========================================================
; REFLOW OVEN CONTROLLER (DE10-Lite CV-8052) - SINGLE FILE
;=========================================================
; UI (when NOT running):
;   - Keypad sets profile params (packed BCD): soak temp/time, peak temp, reflow time
;   - Pages: 0..3 editing, Page 4 shows "PROFILE READY"
;   - SW5 selects DUTY EDIT page (0..100%) and you can still set PWM duty
;   - Digits 0..9 type into 3-digit field
;   - * = ENTER/save, # = CLEAR input
;
; RUN (when running):
;   - Start/Stop button = Row4 Col4 keypad key (KEY_START_BTN)
;   - LCD Line 1: STATE TITLE only (no profile text)
;   - LCD Line 2:
;        SW5=0 -> shows Temperature "T:xxx"
;        SW5=1 -> shows Duty "PWM:xxx%"
;   - HEX2..HEX0 always show oven temperature (decimal)
;
; Timers:
;   - Timer2 = 1kHz ISR:
;        * Generates PWM on P2.7 from PWM_duty (0..100)
;        * Builds 1-second counter in 'seconds'
;   - Timer0 = square-wave audio (kept from your original)
;
; FSM states (matches your diagram labels):
;   0 IDLE
;   1 RAMP TO SOAK      (full power until oven >= soak_temp)
;   2 SOAK             (low power until seconds >= soak_time)
;   3 RAMP TO PEAK      (use ?T table toward peak; when reach 217C -> start REFLOW time)
;   4 REFLOW            (reflow time counts here; must remain >=217C; still allowed to rise to peak)
;   5 COOLING           (heater off; cool to 50C then stop)
;
; IMPORTANT (your request):
;   - Reflow time starts as soon as oven reaches 217C (LIQUIDUS)
;   - While in REFLOW (state 4) and time not done:
;       * keep oven >=217C
;       * continue heating toward peak using ?T table until peak reached
;       * once peak reached, PWM goes 0% (coast). If it falls to 217C, hold 5-10% duty.
;   - After reflow time done:
;       * PWM = 0%
;       * wait until oven <=217C, then go to COOLING (state 5)
;
; DEBUG TEMP:
;   - Fake_OvenTemp_Update updates oven_temp once per second using PWM_duty
;   - Replace Fake_OvenTemp_Update later with real sensor code
;=========================================================


;=========================================================
; CLOCK + TIMERS
;=========================================================
CLK           EQU 33333333

TIMER0_RATE   EQU 4096
TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE))))

TIMER2_RATE   EQU 1000
TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))

SOUND_OUT     EQU P2.1
PWM           EQU P2.7

KEY_STAR      EQU 0x0E      ; *
KEY_POUND     EQU 0x0F      ; #

;---------------------------------------------------------
; START/STOP button = Row4 Col4 on keypad
; NOTE: This keycode depends on your Read_keypad.inc mapping.
; Commonly Row4 Col4 ("D") is 0x0D. If yours differs, change only this.
;---------------------------------------------------------
KEY_START_BTN EQU 0x0D

; LCD value field start column (after "SOAK Tmp: ")
VALUE_COL     EQU 11        ; value occupies col 11..13

;=========================================================
; DUTY-CYCLE EDIT MODE SWITCH
; NOTE: If your switch symbol isn't SWA, change this line
;=========================================================
SW5           EQU SWA.5

;=========================================================
; REFLOW LIQUIDUS CONSTRAINT + HOLD DUTY
;=========================================================
LIQUIDUS      EQU 217
HOLD_DUTY     EQU 8          ; 5-10% keepalive at 217 barrier


;=========================================================
; VECTORS
;=========================================================
org 0x0000
    ljmp main
org 0x000B
    ljmp Timer0_ISR
org 0x002B
    ljmp Timer2_ISR


;=========================================================
; DATA
;=========================================================
dseg at 0x30
PWM_counter:  ds 1
PWM_duty:     ds 1

bcd:          ds 5          ; packed BCD digit buffer (typed digits go here)
param_index:  ds 1          ; 0..4

soak_temp:    ds 2          ; packed BCD (3 digits) in 2 bytes
soak_time:    ds 2
reflow_temp:  ds 2          ; used as PEAK TEMP target
reflow_time:  ds 2          ; used as REFLOW TIME duration (time above liquidus)

;-----------------------------
; FSM DATA
;-----------------------------
state:        ds 1          ; 0..5
run_flag:     ds 1          ; 0=stopped, 1=running

ms_count:     ds 2          ; 0..999 from Timer2 1kHz
seconds:      ds 2          ; elapsed seconds within current state

oven_temp:    ds 2          ; oven temperature (binary °C) - DEBUG generator updates this

tmp16:        ds 2          ; scratch 16-bit
target16:     ds 2          ; scratch 16-bit

bseg
blank_flag:   dbit 1         ; 1 = nothing typed yet
duty_mode:    dbit 1         ; 1 = SW5 duty edit page active (ONLY when NOT running)

cseg


;=========================================================
; LCD WIRING
;=========================================================
ELCD_RS equ P0.0
ELCD_E  equ P0.2
ELCD_D4 equ P0.7
ELCD_D5 equ P0.5
ELCD_D6 equ P0.3
ELCD_D7 equ P0.1

$NOLIST
$include(LCD_4bit_DE10Lite_no_RW.inc)
$include(Read_keypad.inc)
$LIST


;=========================================================
; STRINGS (<=16 chars for full row)
;=========================================================
soaktemp_str:    db 'SOAK Tmp: ',0
soaktime_str:    db 'SOAK time:',0
reflowtemp_str:  db 'PEAK Tmp: ',0
reflowtime_str:  db 'REFL time:',0
profile_ready:   db 'PROFILE READY',0
pwm_str:         db 'PWM Duty: ',0

help_str:        db '0-999*=ENT#=CLR',0

; RUN display (line 1)
s_idle:          db 'IDLE            ',0
s_ramp_soak:     db 'RAMP TO SOAK    ',0
s_soak:          db 'SOAK            ',0
s_ramp_peak:     db 'RAMP TO PEAK    ',0
s_reflow:        db 'REFLOW          ',0
s_cool:          db 'COOLING         ',0

; RUN display (line 2)
temp_lbl:        db 'T:',0
duty_lbl:        db 'PWM:',0
pct_lbl:         db '%',0


;=========================================================
; 7SEG TABLE
;=========================================================
T_7seg:
    DB 0xC0,0xF9,0xA4,0xB0,0x99
    DB 0x92,0x82,0xF8,0x80,0x90


;=========================================================
; TIMER0 (SQUARE WAVE AUDIO)
;=========================================================
Timer0_Init:
    mov TMOD,#01h
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    setb ET0
    setb TR0
    ret

Timer0_ISR:
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    cpl SOUND_OUT
    reti


;=========================================================
; TIMER2 (1kHz ISR) + PWM (0..100%) + 1-second timebase
;=========================================================
Timer2_Init:
    mov T2CON,#0
    mov TH2,#high(TIMER2_RELOAD)
    mov TL2,#low(TIMER2_RELOAD)
    mov RCAP2H,#high(TIMER2_RELOAD)
    mov RCAP2L,#low(TIMER2_RELOAD)

    mov PWM_counter,#0
    mov PWM_duty,#0

    clr a
    mov ms_count+0,a
    mov ms_count+1,a
    mov seconds+0,a
    mov seconds+1,a

    setb ET2
    setb TR2
    ret

Timer2_ISR:
    clr TF2
    push acc
    push psw

    ;-----------------------------
    ; PWM (0..100)
    ;-----------------------------
    mov a, PWM_duty
    cjne a, #100, pwm_normal
    setb PWM
    sjmp pwm_update_counter

pwm_normal:
    mov a, PWM_counter
    jnz p1x
    setb PWM
p1x:
    cjne a, PWM_duty, p2x
    clr PWM
p2x:

pwm_update_counter:
    mov a, PWM_counter
    inc a
    cjne a, #100, p3x
    mov a, #0
p3x:
    mov PWM_counter, a

    ;-----------------------------
    ; 1-second counter from 1kHz ISR
    ;-----------------------------
    inc ms_count+0
    mov a, ms_count+0
    jnz T2_ms_nocarry
    inc ms_count+1
T2_ms_nocarry:

    mov a, ms_count+0
    cjne a, #LOW(1000), T2_exit_time
    mov a, ms_count+1
    cjne a, #HIGH(1000), T2_exit_time

    clr a
    mov ms_count+0, a
    mov ms_count+1, a

    inc seconds+0
    mov a, seconds+0
    jnz T2_exit_time
    inc seconds+1

T2_exit_time:
    pop psw
    pop acc
    reti


;=========================================================
; INPUT HELPERS
;=========================================================
Clear_Input:
    clr a
    mov bcd+0,a
    mov bcd+1,a
    mov bcd+2,a
    mov bcd+3,a
    mov bcd+4,a
    setb blank_flag
    ret


;=========================================================
; LCD HELPERS
;=========================================================
LCD_Clear:
    WriteCommand(#01h)
    Wait_Milli_Seconds(#2)
    ret

LCD_ClearValueArea:
    Set_Cursor(1,VALUE_COL)
    WriteData(#' ')
    WriteData(#' ')
    WriteData(#' ')
    ret

LCD_ClearLine2:
    Set_Cursor(2,1)
    mov R0,#16
L2C1:
    WriteData(#' ')
    djnz R0,L2C1
    ret


;=========================================================
; GET LSD 3 DIGITS FROM BCD INTO R0/R1/R2
; R0=hundreds, R1=tens, R2=units
;=========================================================
Get_LSD3:
    mov a,bcd+0
    anl a,#0Fh
    mov R2,a

    mov a,bcd+0
    swap a
    anl a,#0Fh
    mov R1,a

    mov a,bcd+1
    anl a,#0Fh
    mov R0,a
    ret


;=========================================================
; WriteDigitA: prints A (0..9) as ASCII on LCD
;=========================================================
WriteDigitA:
    cjne a,#0,WD1
    WriteData(#'0')
    ret
WD1: cjne a,#1,WD2
    WriteData(#'1')
    ret
WD2: cjne a,#2,WD3
    WriteData(#'2')
    ret
WD3: cjne a,#3,WD4
    WriteData(#'3')
    ret
WD4: cjne a,#4,WD5
    WriteData(#'4')
    ret
WD5: cjne a,#5,WD6
    WriteData(#'5')
    ret
WD6: cjne a,#6,WD7
    WriteData(#'6')
    ret
WD7: cjne a,#7,WD8
    WriteData(#'7')
    ret
WD8: cjne a,#8,WD9
    WriteData(#'8')
    ret
WD9:
    WriteData(#'9')
    ret


;=========================================================
; LCD_ShowInput: right-aligned 3-char field
;=========================================================
LCD_ShowInput:
    lcall LCD_ClearValueArea
    jb blank_flag, LSI_done

    lcall Get_LSD3

    mov a,R0
    jnz LSI_3

    mov a,R1
    jnz LSI_2

LSI_1:
    Set_Cursor(1,VALUE_COL+2)
    mov a,R2
    lcall WriteDigitA
    sjmp LSI_done

LSI_2:
    Set_Cursor(1,VALUE_COL+1)
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA
    sjmp LSI_done

LSI_3:
    Set_Cursor(1,VALUE_COL)
    mov a,R0
    lcall WriteDigitA
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA

LSI_done:
    ret


;=========================================================
; HEX_ShowInput (HEX2 HEX1 HEX0) no leading zeros
;=========================================================
HEX_ShowInput:
    mov dptr,#T_7seg
    jb blank_flag, HX_blank

    lcall Get_LSD3

    mov a,R0
    jz HX_h_blank
    movc a,@a+dptr
    mov HEX2,a
    sjmp HX_tens
HX_h_blank:
    mov HEX2,#0FFh

HX_tens:
    mov a,R1
    jnz HX_t_show
    mov a,R0
    jz  HX_t_blank
HX_t_show:
    mov a,R1
    movc a,@a+dptr
    mov HEX1,a
    sjmp HX_units
HX_t_blank:
    mov HEX1,#0FFh

HX_units:
    mov a,R2
    movc a,@a+dptr
    mov HEX0,a
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret

HX_blank:
    mov HEX0,#0FFh
    mov HEX1,#0FFh
    mov HEX2,#0FFh
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret


;=========================================================
; LCD_Update screens for each parameter (ONLY when NOT running)
; If duty_mode=1, show PWM Duty edit page instead
;=========================================================
LCD_Update:
    lcall LCD_Clear
    lcall LCD_ClearLine2

    jnb duty_mode, LCD_param_pages
    ljmp LCD_DUTY_PAGE

LCD_param_pages:
