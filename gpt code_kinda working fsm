;=========================================================
; Fake temperature generator (once/sec)
; frozen while paused or error screen
;=========================================================
Fake_OvenTemp_Update:
    mov a, ms_count+0
    orl a, ms_count+1;
    jnz FOT_done

   jb paused_flag, FOT_done
    jb error_demo_flag, FOT_done

    mov a, run_flag
    jnz FOT_running

FOT_idle:
    mov a, oven_temp+0
    cjne a, #25, FOT_idle_checkdir
    mov a, oven_temp+1
    cjne a, #0,  FOT_idle_checkdir
    sjmp FOT_done

FOT_idle_checkdir:
    mov target16+0, #25
    mov target16+1, #0
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FOT_idle_cool
    lcall Temp_Add1
    sjmp FOT_clamp
FOT_idle_cool:
    lcall Temp_Sub1
    sjmp FOT_clamp

FOT_running:
    mov a, PWM_duty
    jz FOT_cool_fast

    mov a, PWM_duty
    clr c
    subb a, #60
    jc FOT_heat_med
    lcall Temp_Add6
    sjmp FOT_clamp
FOT_heat_med:
    mov a, PWM_duty
    clr c
    subb a, #30
    jc FOT_heat_low
    lcall Temp_Add3
    sjmp FOT_clamp
FOT_heat_low:
    lcall Temp_Add1
    sjmp FOT_clamp

FOT_cool_fast:
    lcall Temp_Sub4

FOT_clamp:
    mov target16+0, #LOW(300)
    mov target16+1, #HIGH(300)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FOT_done
    mov oven_temp+0, #LOW(300)
    mov oven_temp+1, #HIGH(300)

FOT_done:
    ret

Temp_Add1:
    inc oven_temp+0
    mov a, oven_temp+0
    jnz TA1_done
    inc oven_temp+1
TA1_done:
    ret
Temp_Add3:
    lcall Temp_Add1
    lcall Temp_Add1
    lcall Temp_Add1
    ret
Temp_Add6:
    lcall Temp_Add3
    lcall Temp_Add3
    ret
Temp_Sub1:
    mov a, oven_temp+0
    orl a, oven_temp+1
    jz TS1_done
    dec oven_temp+0
    mov a, oven_temp+0
    cjne a, #0FFh, TS1_done
    dec oven_temp+1
TS1_done:
    ret
Temp_Sub4:
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    ret

