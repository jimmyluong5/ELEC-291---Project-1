L4y:
    Set_Cursor(1,1)
    Send_Constant_String(#profile_ready)
    ret


;=========================================================
; SAVE PARAMS (from typed bcd)
;=========================================================
Save_Param:
    mov a,param_index
    cjne a,#0,s1
    mov soak_temp+0,bcd+0
    mov soak_temp+1,bcd+1
    ret
s1:
    cjne a,#1,s2
    mov soak_time+0,bcd+0
    mov soak_time+1,bcd+1
    ret
s2:
    cjne a,#2,s3
    mov reflow_temp+0,bcd+0
    mov reflow_temp+1,bcd+1
    ret
s3:
    mov reflow_time+0,bcd+0
    mov reflow_time+1,bcd+1
    ret


;=========================================================
; SAVE DUTY (0..100) from typed digits (clamp >100)
;=========================================================
Save_Duty:
    jb blank_flag, SD_zero

    lcall Get_LSD3

    mov a, R0
    cjne a, #0, SD_h_nonzero
    mov a, R1
    mov b, #10
    mul ab
    add a, R2
    mov PWM_duty, a
    ret

SD_h_nonzero:
    cjne a, #1, SD_clamp100
    mov a, R1
    orl a, R2
    jz SD_exact100
SD_clamp100:
    mov PWM_duty, #100
    ret

SD_exact100:
    mov PWM_duty, #100
    ret

SD_zero:
    mov PWM_duty, #0
    ret


;=========================================================
; PWM SETTERS (used by FSM)
;=========================================================
Set_PWM_Off:   
mov PWM_duty, #0    
ret
Set_PWM_Full:  
mov PWM_duty, #100  
ret
Set_PWM_Low:   
mov PWM_duty, #30   
ret
Set_PWM_Med:   
mov PWM_duty, #60   
ret


;=========================================================
; PackedBCD3_to_Bin16_DATA
; IN:  R0 -> packed BCD (2 bytes) in internal RAM
; OUT: tmp16 = binary (0..999)
;=========================================================
PackedBCD3_to_Bin16_DATA:
    push 0
    push acc
    push b

    ; units
    mov a, @r0
    anl a, #0Fh
    mov R2, a

    ; tens
    mov a, @r0
    swap a
    anl a, #0Fh
    mov R1, a

    ; hundreds from second byte low nibble
    inc R0
    mov a, @r0
    anl a, #0Fh
    mov R3, a
    dec R0

    ; tmp16 = hundreds*100
    mov a, R3
    mov b, #100
    mul ab
    mov tmp16+0, a
    mov tmp16+1, b

    ; + tens*10
    mov a, R1
    mov b, #10
    mul ab
    add a, tmp16+0
    mov tmp16+0, a
    mov a, b
    addc a, tmp16+1
    mov tmp16+1, a

    ; + units
    mov a, tmp16+0
    add a, R2
    mov tmp16+0, a
    mov a, tmp16+1
    addc a, #0
    mov tmp16+1, a

    pop b
    pop acc
    pop 0
    ret


;=========================================================
; GE16: C=1 if (tmp16 >= target16) else C=0
;=========================================================
GE16:
    push acc
    mov a, tmp16+1
    clr c
    subb a, target16+1
    jc  GE16_no
    jnz GE16_yes
    mov a, tmp16+0
    clr c
    subb a, target16+0
    jc  GE16_no
GE16_yes:
    setb c
    pop acc
    ret
GE16_no:
    clr c
    pop acc
    ret


;=========================================================
; Duty_From_DeltaT
; Uses:
;   target16 = T_target (peak temp, binary)
;   tmp16    = T_measured (oven temp, binary)
; Output:
;   PWM_duty per table:
;     ?T <= 0     -> 0
;     <= 2        -> 5
;     <= 5        -> 10
;     <= 10       -> 25
;     <= 20       -> 45
;     <= 30       -> 70
;     > 30        -> 100
;=========================================================
Duty_From_DeltaT:
    ; if measured >= target -> duty 0
    lcall GE16
    jnc DFDT_measured_lt_target
    mov PWM_duty, #0
    ret

DFDT_measured_lt_target:
    ; delta = target - measured (low byte enough for 0..300)
    mov a, target16+0
    clr c
    subb a, tmp16+0
    mov R0, a                 ; R0 = ?T

    ; ?T <= 2 -> 5%
    mov a, R0
    clr c
    subb a, #2
    jnc DFDT_gt2
    mov PWM_duty, #5
    ret
DFDT_gt2:
    ; ?T <= 5 -> 10%
    mov a, R0
    clr c
    subb a, #5
    jnc DFDT_gt5
    mov PWM_duty, #10
    ret
DFDT_gt5:
    ; ?T <= 10 -> 25%
    mov a, R0
    clr c
    subb a, #10
    jnc DFDT_gt10
    mov PWM_duty, #25
    ret
DFDT_gt10:
    ; ?T <= 20 -> 45%
    mov a, R0
    clr c
    subb a, #20
    jnc DFDT_gt20
    mov PWM_duty, #45
    ret
DFDT_gt20:
    ; ?T <= 30 -> 70%
    mov a, R0
    clr c
    subb a, #30
    jnc DFDT_gt30
    mov PWM_duty, #70
    ret
DFDT_gt30:
    mov PWM_duty, #100
    ret


;=========================================================
; FSM_Control
;=========================================================
FSM_Control:
    mov a, run_flag
    jnz FSM_go
    mov state, #0
    lcall Set_PWM_Off
    ret

FSM_go:
    mov a, state

; S0: IDLE
FSM_s0:
    cjne a, #0, FSM_s1
    lcall Set_PWM_Off
    ret

; S1: RAMP TO SOAK until oven_temp >= soak_temp
FSM_s1:
    cjne a, #1, FSM_s2
    lcall Set_PWM_Full

    mov R0, #soak_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FSM_ret_s1

    mov state, #2
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s1:
    ret

; S2: SOAK until seconds >= soak_time
FSM_s2:
    cjne a, #2, FSM_s3
    lcall Set_PWM_Low

    mov R0, #soak_time
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, seconds+0
    mov tmp16+1, seconds+1
    lcall GE16
    jnc FSM_ret_s2

    mov state, #3
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s2:
    ret

; S3: RAMP TO PEAK
; - Duty uses ?T table toward PEAK target
; - As soon as oven reaches 217C, we enter REFLOW (state 4) and start reflow timer
FSM_s3:
    cjne a, #3, FSM_s4

    ; If oven_temp >= LIQUIDUS -> start REFLOW timing immediately
    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FSM_s3_heat_to_peak         ; not yet at 217

    ; reached 217: enter reflow timing state
    mov state, #4
    clr a
    mov seconds+0, a
    mov seconds+1, a
    ret

FSM_s3_heat_to_peak:
    ; target16 = PEAK temp (reflow_temp)
    mov R0, #reflow_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    ; measured = oven_temp
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1

    ; duty per ?T table
    lcall Duty_From_DeltaT
    ret


; S4: REFLOW (time above liquidus)
; - Timer seconds counts here (reflow_time duration)
; - While time not done:
;     * always keep >=217
;     * still allowed to rise toward PEAK using ?T table
;     * once PEAK reached -> PWM=0 (coast); if it falls to 217 -> HOLD_DUTY
; - When time done:
;     * PWM=0
;     * wait until oven <=217 then go COOLING
FSM_s4:
    cjne a, #4, FSM_s4_not
    sjmp FSM_s4_code
    
FSM_s4_not:
	ljmp FSM_s5
FSM_s4_code:

    ;-----------------------------
    ; check if reflow time is finished
    ; target16 = reflow_time (seconds)
    ;-----------------------------
    mov R0, #reflow_time
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, seconds+0
    mov tmp16+1, seconds+1
    lcall GE16
    jc  FSM_s4_done

    ;-----------------------------
    ; time NOT done: control to satisfy:
    ;   - never below 217
    ;   - try to reach PEAK, but once PEAK reached -> 0%
    ;-----------------------------

    ; first: compare to PEAK target
    mov R0, #reflow_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1

    ; if oven >= PEAK -> duty 0 (coast)
    lcall GE16
    jnc FSM_s4_not_at_peak
    mov PWM_duty, #0
    ; but if it has fallen to 217 or below, hold a small duty to stay at ~217
    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_ret               ; still >=217, keep 0
    mov PWM_duty, #HOLD_DUTY
FSM_s4_ret:
    ret

FSM_s4_not_at_peak:
    ; not at peak yet -> compute duty from ?T table toward PEAK
    ; (target16/tmp16 already set for peak vs oven)
    lcall Duty_From_DeltaT

    ; enforce >=217: if oven <217, make sure duty is at least HOLD_DUTY
    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_ret2              ; oven >=217 ok

    ; oven <217: ensure duty >= HOLD_DUTY
    mov a, PWM_duty
    clr c
    subb a, #HOLD_DUTY
    jc  FSM_s4_force_hold
    ret
FSM_s4_force_hold:
    mov PWM_duty, #HOLD_DUTY
FSM_s4_ret2:
    ret

FSM_s4_done:
    ; time done -> PWM off
    mov PWM_duty, #0

    ; wait until oven <=217 then go cooling
    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_done_wait          ; still >=217

    mov state, #5
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_s4_done_wait:
    ret


; S5: COOLING (heater off) until oven_temp < 50 then stop
FSM_s5:
    lcall Set_PWM_Off

    mov target16+0, #50
    mov target16+1, #0

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_ret_s5          ; still >=50

    mov state, #0
    mov run_flag, #0
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s5:
    ret


;=========================================================
; DEBUG: Convert oven_temp (binary) -> R0,R1,R2 digits
;=========================================================
Bin16_To_3Digits:
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1

    clr a
    mov R0, a
    mov R1, a
    mov R2, a

B16_hund_loop:
    mov target16+0, #100
    mov target16+1, #0
    lcall GE16
    jnc B16_hund_done
    mov a, tmp16+0
    clr c
    subb a, #100
    mov tmp16+0, a
    mov a, tmp16+1
    subb a, #0
    mov tmp16+1, a
    inc R0
    sjmp B16_hund_loop
B16_hund_done:

B16_tens_loop:
    mov target16+0, #10
    mov target16+1, #0
    lcall GE16
    jnc B16_tens_done
    mov a, tmp16+0
    clr c
    subb a, #10
    mov tmp16+0, a
    mov a, tmp16+1
    subb a, #0
    mov tmp16+1, a
    inc R1
    sjmp B16_tens_loop
B16_tens_done:
    mov R2, tmp16+0
    ret


;=========================================================
; DEBUG: HEX shows oven_temp decimal on HEX2..HEX0 (no leading zeros)
;=========================================================
HEX_Show_OvenTemp:
    mov dptr,#T_7seg
    lcall Bin16_To_3Digits

    mov a, R0
    jz HOT_h_blank
    movc a, @a+dptr
    mov HEX2, a
    sjmp HOT_tens
HOT_h_blank:
    mov HEX2, #0FFh

HOT_tens:
    mov a, R1
    jnz HOT_t_show
    mov a, R0
    jz  HOT_t_blank
HOT_t_show:
    mov a, R1
    movc a, @a+dptr
    mov HEX1, a
    sjmp HOT_units
HOT_t_blank:
    mov HEX1, #0FFh

HOT_units:
    mov a, R2
    movc a, @a+dptr
    mov HEX0, a
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret


;=========================================================
; RUN DISPLAY: State title on line 1 (no PROFILE READY while running)
