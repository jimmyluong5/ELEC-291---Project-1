    ret
SST2:
    cjne a, #2, SST3
    Set_Cursor(1,1)
    Send_Constant_String(#s_soak)
    ret
SST3:
    cjne a, #3, SST4
    Set_Cursor(1,1)
    Send_Constant_String(#s_ramp_peak)
    ret
SST4:
    cjne a, #4, SST5
    Set_Cursor(1,1)
    Send_Constant_String(#s_reflow)
    ret
SST5:
    Set_Cursor(1,1)
    Send_Constant_String(#s_cool)
