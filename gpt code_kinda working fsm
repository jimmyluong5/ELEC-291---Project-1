LCD_DUTY_PAGE:
    Set_Cursor(1,1)
    Send_Constant_String(#pwm_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret

L1y:
    cjne a,#1,L2y
    Set_Cursor(1,1)
    Send_Constant_String(#soaktime_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L2y:
    cjne a,#2,L3y
    Set_Cursor(1,1)
    Send_Constant_String(#reflowtemp_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L3y:
    cjne a,#3,L4y
    Set_Cursor(1,1)
    Send_Constant_String(#reflowtime_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
