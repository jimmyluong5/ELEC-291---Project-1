Display_Status_All:
    lcall LCD_ShowStatus
    lcall HEX_Show_OvenTemp
    ret

;=========================================================
; DEBUG: Fake temperature generator (updates once per second)
; - Heats based on PWM_duty, cools when PWM_duty=0
; - Clamped 0..300
;=========================================================
Fake_OvenTemp_Update:
    ; only update right after 1-second rollover (ms_count == 0)
    mov a, ms_count+0
    orl a, ms_count+1
    jnz FOT_done

    ; not running: drift toward 25C
    mov a, run_flag
    jnz FOT_running

FOT_idle:
    ; if oven_temp == 25 do nothing
    mov a, oven_temp+0
    cjne a, #25, FOT_idle_checkdir
    mov a, oven_temp+1
    cjne a, #0,  FOT_idle_checkdir
    sjmp FOT_done

FOT_idle_checkdir:
    ; if oven_temp >= 25 cool by 1 else heat by 1
    mov target16+0, #25
    mov target16+1, #0
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FOT_idle_cool
    lcall Temp_Add1
    sjmp FOT_clamp
FOT_idle_cool:
    lcall Temp_Sub1
    sjmp FOT_clamp

FOT_running:
    mov a, PWM_duty
    jz FOT_cool_fast

    ; duty >= 60 => +6
    mov a, PWM_duty
    clr c
    subb a, #60
    jc FOT_heat_med
    lcall Temp_Add6
    sjmp FOT_clamp

FOT_heat_med:
    ; duty >= 30 => +3
    mov a, PWM_duty
    clr c
    subb a, #30
    jc FOT_heat_low
    lcall Temp_Add3
    sjmp FOT_clamp

FOT_heat_low:
    ; duty 1..29 => +1
    lcall Temp_Add1
    sjmp FOT_clamp

FOT_cool_fast:
    ; duty == 0 => -4
    lcall Temp_Sub4

FOT_clamp:
    ; clamp upper to 300
    mov target16+0, #LOW(300)
    mov target16+1, #HIGH(300)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FOT_done
    mov oven_temp+0, #LOW(300)
    mov oven_temp+1, #HIGH(300)

FOT_done:
    ret

;=========================================================
; TEMP helpers (16-bit unsigned oven_temp)
;=========================================================
Temp_Add1:
    inc oven_temp+0
    mov a, oven_temp+0
    jnz TA1_done
    inc oven_temp+1
TA1_done:
    ret

Temp_Add3:
    lcall Temp_Add1
    lcall Temp_Add1
    lcall Temp_Add1
    ret

Temp_Add6:
    lcall Temp_Add3
    lcall Temp_Add3
    ret

Temp_Sub1:
    ; if oven_temp == 0 => stay 0
    mov a, oven_temp+0
    orl a, oven_temp+1
    jz TS1_done
    dec oven_temp+0
    mov a, oven_temp+0
    cjne a, #0FFh, TS1_done
    dec oven_temp+1
TS1_done:
    ret

Temp_Sub4:
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    lcall Temp_Sub1
    ret

;=========================================================
; HANDLE KEYPAD INPUT (R7 keycode)
; - KEY 1 toggles run/stop (FSM)
; - If duty_mode=1, ENTER(*) saves PWM duty instead of params
;=========================================================
Handle_Key:
    mov a,R7

    ; START/STOP (key 1)
    cjne a,#KEY_START_1, HK_enter
    mov a, run_flag
    xrl a, #1
    mov run_flag, a

    ; if turning ON -> go to state 1 and reset seconds
    jz HK_start_done
    mov state, #1
    clr a
    mov seconds+0, a
    mov seconds+1, a
HK_start_done:
    ret

HK_enter:
    ; ENTER (*)
    cjne a,#KEY_STAR,HK_clear
    jb duty_mode, HK_save_duty

    lcall Save_Param
    mov a,param_index
    cjne a,#4,HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_save_duty:
    lcall Save_Duty
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    cjne a,#KEY_POUND,HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    ; accept only 0..9
    mov a,R7
    cjne a,#0Ah,HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

;=========================================================
; MAIN
;=========================================================
main:
    mov SP,#7Fh

    ; set the pins to output (your original)
    mov P0MOD,#10101111b
    mov P1MOD,#10000010b
    mov P2MOD,#10000010b

    ; defaults
    clr a
    mov param_index,a
    clr duty_mode

    mov state, #0
    mov run_flag, #0

    ; start fake temp at room temp 25C
    mov oven_temp+0, #25
    mov oven_temp+1, #0

    lcall Clear_Input
    lcall Configure_Keypad_Pins

    lcall Timer0_Init
    lcall Timer2_Init

    setb PWM
    setb EA

    lcall ELCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    ;=====================================================
    ; SW5 selects DUTY MODE (1) vs PARAM MODE (0)
    ;=====================================================
    jb SW5, SW5_ON

SW5_OFF:
    jb duty_mode, MODE_TO_PARAM
    sjmp SW5_DONE
MODE_TO_PARAM:
    clr duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    sjmp SW5_DONE

SW5_ON:
    jnb duty_mode, MODE_TO_DUTY
    sjmp SW5_DONE
MODE_TO_DUTY:
    setb duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput

SW5_DONE:

    ;=====================================================
    ; Keypad
    ;=====================================================
    lcall Keypad
    jnc NO_KEY
    lcall Handle_Key
NO_KEY:

    ;=====================================================
    ; DEBUG TEMP + FSM + DISPLAY (LCD + HEX)
    ;=====================================================
    lcall Fake_OvenTemp_Update
    lcall FSM_Control
    lcall Display_Status_All

    sjmp loop

END
