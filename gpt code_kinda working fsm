;=========================================================
; Handle_Key (called only on "click" due to key_lock in main)
;=========================================================
Handle_Key:
    mov a, R7

    ; running time reset key '1' works anytime
    cjne a, #KEY_TIME_RESET, HK0
    clr a
    mov run_time+0,a
    mov run_time+1,a
    ret
HK0:

    ; ERROR button B: 10 beeps + error screen then menu
    cjne a, #KEY_ERR_BTN, HK_chk_stop
    setb error_demo_flag
    mov state,#ERROR_STATE
    mov run_flag,#0
    clr paused_flag
    lcall Set_PWM_Off
    lcall Show_Error_Message
    lcall Beep_Once
    mov beep_count,#9
    ret

HK_chk_stop:
    ; STOP (C): click pauses IF running
    cjne a, #KEY_STOP_BTN, HK_chk_start

    mov a, run_flag
    jz  HK_stop_exit_near      ; (near) can't jump directly to HK_done

    jb  paused_flag, HK_stop_exit_near  ; already paused -> ignore click

    setb paused_flag
    lcall Set_PWM_Off
    ret

HK_stop_exit_near:
    ljmp HK_done 

HK_chk_start:
    ; START (D):
    cjne a, #KEY_START_BTN, HK_not_control

    ; if error screen active -> return to menu
    jb error_demo_flag, HK_clear_err_to_menu

    ; if paused -> resume (do NOT reset state/time/temp)
    jb paused_flag, HK_resume
    sjmp HK_toggle_run

HK_resume:
    clr paused_flag
    ret

HK_clear_err_to_menu:
    ; stop beeps after finishing naturally is fine, but user wants ability to reset now
    lcall Return_To_Menu
    ret

HK_toggle_run:
    mov a, run_flag
    xrl a, #1
    mov run_flag, a

    jz HK_stopped
    mov state, #1
    clr a
    mov seconds+0,a
    mov seconds+1,a
    mov reflow_done_flag,#0
    mov reflow_beeped,#0
    mov temp_stall_secs,#0
    clr paused_flag
    lcall LCD_Clear
    ret

HK_stopped:
    mov state,#0
    clr paused_flag
    lcall Set_PWM_Off
    ret

HK_not_control:
    ; if running OR paused OR error screen -> ignore edits
    mov a, run_flag
    jnz HK_done
    jb paused_flag, HK_done
    jb error_demo_flag, HK_done

    ; ENTER (*)
    mov a, R7
    cjne a, #KEY_STAR, HK_clear
    jb duty_mode, HK_save_duty

    lcall Save_Param
    mov a, param_index
    cjne a, #4, HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_save_duty:
    lcall Save_Duty
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    mov a, R7
    cjne a, #KEY_POUND, HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    mov a, R7
    cjne a, #0Ah, HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_done:
    ret

;=========================================================
; MAIN
;=========================================================
main:
    mov SP,#7Fh

    mov P0MOD,#10101111b
    mov P1MOD,#10100010b
    mov P2MOD,#10000010b
    setb P1.5

    clr a
    mov param_index,a
    clr duty_mode
    
    mov a, LEDRA
    clr a
    mov LEDRA, a
    setb LEDRA.5

    mov state,#0
    mov prev_state,#0
    mov run_flag,#0

    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    mov reflow_done_flag,#0
    mov reflow_beeped,#0

    clr paused_flag
    clr error_demo_flag
    mov err_hold_secs,#0

    mov key_lock,#0
    mov last_key,#0

    ; temps
    mov oven_temp+0,#25
    mov oven_temp+1,#0
    mov last_temp_L,#25
    mov last_temp_H,#0

    ; time
    clr a
    mov run_time+0,a
    mov run_time+1,a
    mov seconds+0,a
    mov seconds+1,a

    lcall Clear_Input
    lcall Configure_Keypad_Pins

    lcall Timer0_Init
    lcall Timer2_Init

    setb PWM
    setb EA

    lcall LCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    ;=====================================================
    ; SW5 behavior:
    ;   - NOT running AND not error screen: SW5 toggles duty edit page
    ;   - Running: SW5 just changes view (handled in Display_Status_All)
    ;=====================================================
    mov a, run_flag
    jnz SKIP_UI_MODE
    jb error_demo_flag, SKIP_UI_MODE

    jb SW5, SW5_ON
SW5_OFF:
    jb duty_mode, MODE_TO_PARAM
    sjmp SW5_DONE
MODE_TO_PARAM:
    clr duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    sjmp SW5_DONE

SW5_ON:
    jnb duty_mode, MODE_TO_DUTY
    sjmp SW5_DONE
MODE_TO_DUTY:
    setb duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput

SW5_DONE:
SKIP_UI_MODE:

    ;=====================================================
    ; Keypad one-shot handling
    ;=====================================================
    lcall Keypad
    jnc NO_KEY

    mov a, key_lock
    jz  PROCESS_KEY
    mov a, R7
    cjne a, last_key, PROCESS_KEY
    sjmp AFTER_KEY

PROCESS_KEY:
    mov key_lock,#1
    mov a,R7
    mov last_key,a
    lcall Handle_Key

AFTER_KEY:
    sjmp KEY_DONE

NO_KEY:
    mov key_lock,#0
KEY_DONE:

    ;=====================================================
    ; If error screen active: after beeps finish, return to menu
    ;=====================================================
    jb error_demo_flag, ERR_SCREEN
    sjmp RUN_NORMAL

ERR_SCREEN:
    ; allow beeps to drain
    lcall Do_ExtraBeeps
    mov a, beep_count
    jnz SHOW_ONLY
    ; done beeping -> return to menu
    lcall Return_To_Menu
SHOW_ONLY:
    lcall Display_Status_All
    sjmp loop

RUN_NORMAL:
    ;=====================================================
    ; TEMP + STALL + FSM + BEEPS + DISPLAY
    ;=====================================================
    lcall Fake_OvenTemp_Update
    lcall Temp_Stall_Check
    lcall FSM_Control

    lcall Beep_On_State_Change
    lcall Do_ExtraBeeps

    lcall Display_Status_All
    sjmp loop

END
