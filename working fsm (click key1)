$MODMAX10

CSEG at 0
    ljmp mycode

DSEG at 30h
x:      ds  4
y:      ds  4
bcd:    ds  5
state:  ds  1 ; Variable to keep track of current state

BSEG
mf:     dbit 1

; Constants
FREQ    EQU 33333333
BAUD    EQU 115200
T2LOAD  EQU 65536-(FREQ/(32*BAUD))

; Hardware mapping for DE10-Lite
BUTTON  EQU KEY.1  ; KEY1 for state transition

$include(math32.asm)

; LCD Pin Mapping
LCD_RS equ P0.0 
LCD_E  equ P0.2 
LCD_D4 equ P0.7
LCD_D5 equ P0.5
LCD_D6 equ P0.3
LCD_D7 equ P0.1 

$NOLIST
$include(LCD_4bit_DE10Lite_no_RW1.inc)
$LIST

; Strings for the FSM
state0_msg: db 'State: 0    ', 0
state1_msg: db 'State: 1', 0
state2_msg: db 'State: 2', 0
state3_msg: db 'State: 3 ', 0

myLUT:
    DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90

; --- Subroutines ---

InitSerialPort:
    clr TR2
    mov T2CON, #30H
    mov RCAP2H, #high(T2LOAD)
    mov RCAP2L, #low(T2LOAD)
    setb TR2
    mov SCON, #52H
    ret

Wait50ms:
    mov R0, #30
x_L3: mov R1, #74
x_L2: mov R2, #250
x_L1: djnz R2, x_L1
    djnz R1, x_L2
    djnz R0, x_L3
    ret

Display_Voltage_LCD:
    Set_Cursor(2,1)
    mov a, #'V'
    lcall ?WriteData
    mov a, #'='
    lcall ?WriteData
    mov a, bcd+1
    swap a
    anl a, #0FH
    orl a, #'0'
    lcall ?WriteData
    mov a, #'.'
    lcall ?WriteData
    mov a, bcd+1
    anl a, #0FH
    orl a, #'0'
    lcall ?WriteData
    mov a, bcd+0
    swap a
    anl a, #0FH
    orl a, #'0'
    lcall ?WriteData
    mov a, bcd+0
    anl a, #0FH
    orl a, #'0'
    lcall ?WriteData
    ret

; --- Main Program ---

mycode:
    mov SP, #7FH
    mov P0MOD, #10101111b
    mov P1MOD, #10000010b
    
    lcall InitSerialPort
    lcall LCD_4BIT
    
    mov ADC_C, #0x80 ; Reset ADC
    lcall Wait50ms
    
    mov state, #0   ; Initialize FSM to State 0
    lcall Update_State_Display

forever:
    ; --- Part 1: Voltmeter Logic ---
    mov a, SWA 
    anl a, #0x07
    mov ADC_C, a
    
    mov x+3, #0
    mov x+2, #0
    mov x+1, ADC_H
    mov x+0, ADC_L
    
    Load_y(5000)
    lcall mul32
    Load_y(4096)
    lcall div32
    
    lcall hex2bcd
    lcall Display_Voltage_LCD ; Update voltage on Line 2
    
    ; --- Part 2: FSM / Button Logic ---
    jb BUTTON, no_press     ; If button is NOT pressed, skip
    lcall Wait50ms          ; Debounce
    jb BUTTON, no_press     ; Double check
    
    ; Button was pressed! Change state logic:
    inc state
    mov a, state
    cjne a, #4, skip_reset  ; If we hit state 4, go back to 0
    mov state, #0
skip_reset:
    lcall Update_State_Display
    
    ; Wait for button release so it doesn't skip states
wait_release:
    jnb BUTTON, wait_release

no_press:
    lcall Wait50ms ; Small loop delay
    ljmp forever

; Helper to refresh Line 1 of LCD based on state
Update_State_Display:
    Set_Cursor(1, 1)
    mov a, state
    cjne a, #0, check1
    Send_Constant_String(#state0_msg)
    ret
check1:
    cjne a, #1, check2
    Send_Constant_String(#state1_msg)
    ret
check2:
    cjne a, #2, check3
    Send_Constant_String(#state2_msg)
    ret
check3:
    Send_Constant_String(#state3_msg)
    ret

end
