;=========================================================
; REFLOW OVEN CONTROLLER (DE10-Lite CV-8052) - SINGLE FILE
;=========================================================
; TIMER MAP (as you requested):
;   - Timer2  = UART baud generator (115200)  [NO Timer2 ISR]
;   - Timer1  = 1kHz system tick ISR + PWM
;   - Timer0  = speaker tone (beeps)
;
; Changes vs your previous version:
;   - Removed Fake_OvenTemp_Update ???????
;   - Added OvenTemp_Update (reads ADC ch0=room, ch1=oven) once/sec while running
;   - PWM + tick moved from Timer2_ISR -> Timer1_ISR
;   - Timer2 now only used for serial baud generation
;
; NOTE (important):
;   This OvenTemp_Update is a *working* ADC->temperature pipeline, but since your
;   exact sensor calibration math wasn’t fully included in the FSM file, I used a
;   clean linear mapping you can tune:
;     room_temp_C  = ADC0 * ROOM_MAX_C / 4095
;     oven_delta_C = ADC1 * OVEN_DELTA_MAX_C / 4095
;     oven_temp_C  = room_temp_C + oven_delta_C
;   You can replace the math section with your final calibrated thermocouple math
;   later without touching the FSM/timers/PWM.
;=========================================================

;=========================================================
; CLOCK + UART
;=========================================================
CLK            EQU 33333333
BAUD           EQU 115200
T2LOAD         EQU (65536-(CLK/(32*BAUD)))   ; Timer2 baud reload

;=========================================================
; TIMERS
;=========================================================
TIMER0_RATE    EQU 4096
TIMER0_RELOAD  EQU (65536-(CLK/(12*TIMER0_RATE)))

TIMER1_RATE    EQU 1000                      ; 1kHz system tick
TIMER1_RELOAD  EQU (65536-(CLK/(12*TIMER1_RATE)))

;=========================================================
; I/O
;=========================================================
SPEAKER        EQU P1.5
PWM            EQU P2.7

;=========================================================
; ADC SFRs (uncomment if your assembler complains)
;=========================================================
; ADC_C DATA 0A1h
; ADC_L DATA 0A2h
; ADC_H DATA 0A3h

;=========================================================
; KEYS (Read_keypad.inc mapping)
;=========================================================
KEY_STAR        EQU 0x0E      ; *
KEY_POUND       EQU 0x0F      ; #
KEY_ERR_BTN     EQU 0x0B      ; B (Row2 Col4)
KEY_STOP_BTN    EQU 0x0C      ; C (Row3 Col4)
KEY_START_BTN   EQU 0x0D      ; D (Row4 Col4)
KEY_TIME_RESET  EQU 0x0A      ; '1' clears running time

;=========================================================
; LCD + SWITCH
;=========================================================
VALUE_COL       EQU 11
SW5             EQU SWA.5

;=========================================================
; REFLOW / LIMITS
;=========================================================
LIQUIDUS        EQU 217
HOLD_DUTY        EQU 8
MAX_TEMP        EQU 250
STALL_LIMIT     EQU 60

;=========================================================
; STATES
;=========================================================
ERROR_STATE     EQU 6
COOL_STATE      EQU 5

;=========================================================
; TEMP MAPPING (TUNE THESE)
;=========================================================
ROOM_MAX_C          EQU 50     ; assume room sensor is 0..50C over 0..4095
OVEN_DELTA_MAX_C    EQU 300    ; assume oven delta is 0..300C over 0..4095

;=========================================================
; VECTORS
;=========================================================
org 0x0000
    ljmp main

org 0x000B              ; Timer0 vector
    ljmp Timer0_ISR

org 0x001B              ; Timer1 vector
    ljmp Timer1_ISR

; (No Timer2 ISR: Timer2 is ONLY for UART baud)

;=========================================================
; DATA
;=========================================================
dseg at 0x30

;=========================================================
; math32 working registers (used by OvenTemp_Update)
;=========================================================
x:                  ds 4
y:                  ds 4

; derived temps
room_temp16:        ds 2          ; integer Celsius
oven_delta16:       ds 2          ; integer Celsius







; PWM + tick
PWM_counter:        ds 1
PWM_duty:           ds 1

; keypad input digits (used by Shift_Digits_Left in Read_keypad.inc)
bcd:                ds 5
param_index:        ds 1

; profile parameters (packed BCD, 3 digits stored in 2 bytes)
soak_temp:          ds 2
soak_time:          ds 2
reflow_temp:        ds 2
reflow_time:        ds 2

; FSM + run control
state:              ds 1
run_flag:           ds 1

; timebase
ms_count:           ds 2          ; counts ms (0..999) from Timer1 ISR
seconds:            ds 2          ; per-state elapsed seconds
run_time:           ds 2          ; total running time

; temperature (FSM uses this)
oven_temp:          ds 2          ; integer Celsius

; scratch / compare
tmp16:              ds 2
target16:           ds 2

; beeps
prev_state:         ds 1
beep_count:         ds 1

; stall detect
last_temp_L:        ds 1
last_temp_H:        ds 1
temp_stall_secs:    ds 1

; error / reflow
error_flag:         ds 1
reflow_done_flag:   ds 1
reflow_beeped:      ds 1

; keypad one-shot
key_lock:           ds 1
last_key:           ds 1

; flags (bit-addressable)
bseg
blank_flag:      dbit 1
duty_mode:       dbit 1
paused_flag:     dbit 1
error_demo_flag: dbit 1
mf: dbit 1


cseg

;=========================================================
; LCD WIRING
;=========================================================
ELCD_RS equ P0.0
ELCD_E  equ P0.2
ELCD_D4 equ P0.7
ELCD_D5 equ P0.5
ELCD_D6 equ P0.3
ELCD_D7 equ P0.1

