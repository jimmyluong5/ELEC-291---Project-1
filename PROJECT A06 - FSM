;=========================================================
; PackedBCD3_to_Bin16_DATA  (R0 -> bcd-like packed 3 digits)
;=========================================================
PackedBCD3_to_Bin16_DATA:
    push 0
    push acc
    push b

    mov a, @r0
    anl a, #0Fh
    mov R2, a

    mov a, @r0
    swap a
    anl a, #0Fh
    mov R1, a

    inc R0
    mov a, @r0
    anl a, #0Fh
    mov R3, a
    dec R0

    mov a, R3
    mov b, #100
    mul ab
    mov tmp16+0, a
    mov tmp16+1, b

    mov a, R1
    mov b, #10
    mul ab
    add a, tmp16+0
    mov tmp16+0, a
    mov a, b
    addc a, tmp16+1
    mov tmp16+1, a

    mov a, tmp16+0
    add a, R2
    mov tmp16+0, a
    mov a, tmp16+1
    addc a, #0
    mov tmp16+1, a

    pop b
    pop acc
    pop 0
    ret

;=========================================================
; GE16: C=1 if tmp16 >= target16
;=========================================================
GE16:
    push acc
    mov a, tmp16+1
    clr c
    subb a, target16+1
    jc  GE16_no
    jnz GE16_yes
    mov a, tmp16+0
    clr c
    subb a, target16+0
    jc  GE16_no
GE16_yes:
    setb c
    pop acc
    ret
GE16_no:
    clr c
    pop acc
    ret

;=========================================================
; Validate_Temp250: C=1 if <=250 else C=0
;=========================================================
Validate_Temp250:
    mov target16+0, #LOW(251)
    mov target16+1, #HIGH(251)
    lcall GE16
    jc  VT_invalid
    setb c
    ret
VT_invalid:
    clr c
    ret

Show_Invalid_Temp:
    lcall LCD_Clear
    Set_Cursor(1,1)
    Send_Constant_String(#inv_msg)
    lcall Wait1s
    lcall LCD_Update
    lcall LCD_ShowInput
    ret

;=========================================================
; Save_Param (temp<=250 enforcement on temp pages)
;=========================================================
Save_Param:
    mov a,param_index
    cjne a,#0,SP1

    mov R0, #bcd
    lcall PackedBCD3_to_Bin16_DATA
    lcall Validate_Temp250
    jnc SP_bad
    mov soak_temp+0,bcd+0
    mov soak_temp+1,bcd+1
    ret

SP1:
    cjne a,#1,SP2
    mov soak_time+0,bcd+0
    mov soak_time+1,bcd+1
    ret

SP2:
    cjne a,#2,SP3
    mov R0, #bcd
    lcall PackedBCD3_to_Bin16_DATA
    lcall Validate_Temp250
    jnc SP_bad
    mov reflow_temp+0,bcd+0
    mov reflow_temp+1,bcd+1
    ret

SP3:
    mov reflow_time+0,bcd+0
    mov reflow_time+1,bcd+1
    ret

SP_bad:
    lcall Show_Invalid_Temp
    ret

;=========================================================
; Save_Duty (0..100)
;=========================================================
Save_Duty:
    jb blank_flag, SD_zero
    lcall Get_LSD3

    mov a, R0
    cjne a, #0, SD_h_nonzero
    mov a, R1
    mov b, #10
    mul ab
    add a, R2
    mov PWM_duty, a
    ret

SD_h_nonzero:
    cjne a, #1, SD_clamp100
    mov a, R1
    orl a, R2
    jz SD_exact100
SD_clamp100:
    mov PWM_duty, #100
    ret
SD_exact100:
    mov PWM_duty, #100
    ret
SD_zero:
    mov PWM_duty, #0
    ret

;=========================================================
; PWM setters
;=========================================================
Set_PWM_Off:   
mov PWM_duty, #0   
ret
Set_PWM_Full:  
mov PWM_duty, #100 
ret
Set_PWM_Low:   
mov PWM_duty, #30  
ret
Set_PWM_Med:   
mov PWM_duty, #60  
ret

;=========================================================
; Duty_From_DeltaT (table)
;=========================================================
Duty_From_DeltaT:
    lcall GE16
    jnc DFDT_measured_lt_target
    mov PWM_duty, #0
    ret
DFDT_measured_lt_target:
    mov a, target16+0
    clr c
    subb a, tmp16+0
    mov R0, a

    mov a, R0
    clr c
    subb a, #2
    jnc DFDT_gt2
    mov PWM_duty, #5
    ret
DFDT_gt2:
    mov a, R0
    clr c
    subb a, #5
    jnc DFDT_gt5
    mov PWM_duty, #10
    ret
DFDT_gt5:
    mov a, R0
    clr c
    subb a, #10
    jnc DFDT_gt10
    mov PWM_duty, #25
    ret
DFDT_gt10:
    mov a, R0
    clr c
    subb a, #20
    jnc DFDT_gt20
    mov PWM_duty, #45
    ret
DFDT_gt20:
    mov a, R0
    clr c
    subb a, #30
    jnc DFDT_gt30
    mov PWM_duty, #70
    ret
DFDT_gt30:
    mov PWM_duty, #100
    ret

;=========================================================
; Temp_Stall_Check (once/sec) - disabled while paused/error
;=========================================================
Temp_Stall_Check:
    mov a, ms_count+0
    orl a, ms_count+1
    jnz TSC_done

    jb paused_flag, TSC_done
    jb error_demo_flag, TSC_done

    mov a, run_flag
    jz  TSC_reset

    mov a, oven_temp+0
    cjne a, last_temp_L, TSC_changed
    mov a, oven_temp+1
    cjne a, last_temp_H, TSC_changed

    inc temp_stall_secs
    mov a, temp_stall_secs
    cjne a, #STALL_LIMIT, TSC_done

    setb error_demo_flag
    mov run_flag, #0
    clr paused_flag
    mov state, #ERROR_STATE
    lcall Set_PWM_Off
    lcall Beep_Once
    mov beep_count, #9
    lcall Show_Error_Message
    ret

TSC_changed:
    mov a, oven_temp+0
    mov last_temp_L, a
    mov a, oven_temp+1
    mov last_temp_H, a
    mov temp_stall_secs, #0
    ret

TSC_reset:
    mov a, oven_temp+0
    mov last_temp_L, a
    mov a, oven_temp+1
    mov last_temp_H, a
    mov temp_stall_secs, #0

TSC_done:
    ret

;=========================================================
; Beep_On_State_Change
;=========================================================
Beep_On_State_Change:
    mov a, state
    cjne a, prev_state, BOSC_changed
    ret
BOSC_changed:
    mov prev_state, a
    lcall Beep_Once
    mov beep_count, #0

    mov a, state
    cjne a, #COOL_STATE, BOSC_chk_err
    mov a, reflow_beeped
    jnz BOSC_done
    mov beep_count, #4
    ret

BOSC_chk_err:
    mov a, state
    cjne a, #ERROR_STATE, BOSC_done
    mov beep_count, #9
BOSC_done:
    ret

;=========================================================
; FSM_Control
;=========================================================
FSM_Control:
    jb paused_flag, FSM_pause_ret
    jb error_demo_flag, FSM_pause_ret

    mov a, run_flag
    jnz FSM_go
    mov state, #0
    lcall Set_PWM_Off
    ret

FSM_pause_ret:
    lcall Set_PWM_Off
    ret

FSM_go:
    mov a, state

FSM_s0:
    cjne a, #0, FSM_s1
    lcall Set_PWM_Off
    ret

FSM_s1:
    cjne a, #1, FSM_s2
    lcall Set_PWM_Full

    mov R0, #soak_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FSM_ret_s1

    mov state, #2
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s1:
    ret

FSM_s2:
    cjne a, #2, FSM_s3
    lcall Set_PWM_Low

    mov R0, #soak_time
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, seconds+0
    mov tmp16+1, seconds+1
    lcall GE16
    jnc FSM_ret_s2

    mov state, #3
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s2:
    ret

FSM_s3:
    cjne a, #3, FSM_s4

    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jnc FSM_s3_heat_to_peak

    mov state, #4
    clr a
    mov seconds+0, a
    mov seconds+1, a
    mov reflow_done_flag, #0
    mov reflow_beeped, #0
    ret

FSM_s3_heat_to_peak:
    mov R0, #reflow_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall Duty_From_DeltaT
    ret

FSM_s4:
    cjne a, #4, FSM_s4_not
    sjmp FSM_s4_code
FSM_s4_not:
    ljmp FSM_s5

FSM_s4_code:
    mov R0, #reflow_time
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, seconds+0
    mov tmp16+1, seconds+1
    lcall GE16
    jc  FSM_s4_done

    mov R0, #reflow_temp
    lcall PackedBCD3_to_Bin16_DATA
    mov target16+0, tmp16+0
    mov target16+1, tmp16+1

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1

    lcall GE16
    jnc FSM_s4_not_at_peak
    mov PWM_duty, #0

    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_ret
    mov PWM_duty, #HOLD_DUTY
FSM_s4_ret:
    ret

FSM_s4_not_at_peak:
    lcall Duty_From_DeltaT

    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_ret2

    mov a, PWM_duty
    clr c
    subb a, #HOLD_DUTY
    jc  FSM_s4_force_hold
    ret
FSM_s4_force_hold:
    mov PWM_duty, #HOLD_DUTY
FSM_s4_ret2:
    ret

FSM_s4_done:
    mov PWM_duty, #0
    mov reflow_done_flag, #1

    mov a, reflow_beeped
    jnz FSM_s4_done_wait
    mov reflow_beeped, #1
    lcall Beep_Once
    mov beep_count, #4

FSM_s4_done_wait:
    mov target16+0, #LOW(LIQUIDUS)
    mov target16+1, #HIGH(LIQUIDUS)
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_s4_done_wait_ret

    mov state, #5
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_s4_done_wait_ret:
    ret

FSM_s5:
    lcall Set_PWM_Off

    mov target16+0, #50
    mov target16+1, #0

    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1
    lcall GE16
    jc FSM_ret_s5

    mov state, #0
    mov run_flag, #0
    clr a
    mov seconds+0, a
    mov seconds+1, a
FSM_ret_s5:
    ret

;=========================================================
; Bin16 -> 3 digits (for oven_temp)
;=========================================================
Bin16_To_3Digits:
    mov tmp16+0, oven_temp+0
    mov tmp16+1, oven_temp+1

    clr a
    mov R0, a
    mov R1, a
    mov R2, a

B16_hund_loop:
    mov target16+0, #100
    mov target16+1, #0
    lcall GE16
    jnc B16_hund_done
    mov a, tmp16+0
    clr c
    subb a, #100
    mov tmp16+0, a
    mov a, tmp16+1
    subb a, #0
    mov tmp16+1, a
    inc R0
    sjmp B16_hund_loop
B16_hund_done:

B16_tens_loop:
    mov target16+0, #10
    mov target16+1, #0
    lcall GE16
    jnc B16_tens_done
    mov a, tmp16+0
    clr c
    subb a, #10
    mov tmp16+0, a
    mov a, tmp16+1
    subb a, #0
    mov tmp16+1, a
    inc R1
    sjmp B16_tens_loop
B16_tens_done:
    mov R2, tmp16+0
    ret

HEX_Show_OvenTemp:
    mov dptr,#T_7seg
    lcall Bin16_To_3Digits

    mov a, R0
    jz HOT_h_blank
    movc a, @a+dptr
    mov HEX2, a
    sjmp HOT_tens
HOT_h_blank:
    mov HEX2, #0FFh

HOT_tens:
    mov a, R1
    jnz HOT_t_show
    mov a, R0
    jz  HOT_t_blank
HOT_t_show:
    mov a, R1
    movc a,@a+dptr
    mov HEX1, a
    sjmp HOT_units
HOT_t_blank:
    mov HEX1, #0FFh

HOT_units:
    mov a, R2
    movc a,@a+dptr
    mov HEX0, a
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret

;=========================================================
; LCD State Title
;=========================================================
LCD_ShowStateTitle:
    mov a, state
    cjne a, #0, SST1
    Set_Cursor(1,1)
    Send_Constant_String(#s_idle)
    ret
SST1:
    cjne a, #1, SST2
    Set_Cursor(1,1)
    Send_Constant_String(#s_ramp_soak)
    ret
SST2:
    cjne a, #2, SST3
    Set_Cursor(1,1)
    Send_Constant_String(#s_soak)
    ret
SST3:
    cjne a, #3, SST4
    Set_Cursor(1,1)
    Send_Constant_String(#s_ramp_peak)
    ret
SST4:
    cjne a, #4, SST5
    Set_Cursor(1,1)
    Send_Constant_String(#s_reflow)
    ret
SST5:
    cjne a, #5, SST6
    Set_Cursor(1,1)
    Send_Constant_String(#s_cool)
    ret
SST6:
    Set_Cursor(1,1)
    Send_Constant_String(#s_error)
    ret

;=========================================================
; RunTime printing " t:xyz"
;=========================================================
RunTime_To_3Digits:
    mov tmp16+0, run_time+0
    mov tmp16+1, run_time+1

    clr a
    mov R4,a
    mov R5,a
    mov R6,a

RT_h:
    mov target16+0,#100
    mov target16+1,#0
    lcall GE16
    jnc RT_t
    mov a,tmp16+0
    clr c
    subb a,#100
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R4
    sjmp RT_h

RT_t:
    mov target16+0,#10
    mov target16+1,#0
    lcall GE16
    jnc RT_u
    mov a,tmp16+0
    clr c
    subb a,#10
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R5
    sjmp RT_t

RT_u:
    mov R6,tmp16+0
    ret

LCD_ShowTempLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#temp_lbl)

    lcall Bin16_To_3Digits
    mov a, R0
    lcall WriteDigitA
    mov a, R1
    lcall WriteDigitA
    mov a, R2
    lcall WriteDigitA

    Send_Constant_String(#time_lbl)
    lcall RunTime_To_3Digits
    mov a, R4
    lcall WriteDigitA
    mov a, R5
    lcall WriteDigitA
    mov a, R6
    lcall WriteDigitA
    ret

LCD_ShowDutyLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#duty_lbl)

    clr a
    mov R0,a
    mov R1,a
    mov R2,a
    mov a, PWM_duty
    cjne a,#100, DUT_not100
    mov R0,#1
    mov R1,#0
    mov R2,#0
    sjmp DUT_print
DUT_not100:
    mov b,#10
    div ab
    mov R1,a
    mov R2,b
    mov R0,#0
DUT_print:
    mov a,R0
    jnz DUT_pH
    WriteData(#' ')
    sjmp DUT_pT
DUT_pH:
    lcall WriteDigitA
DUT_pT:
    mov a,R1
    jnz DUT_pTshow
    mov a,R0
    jnz DUT_pTshow
    WriteData(#' ')
    sjmp DUT_pU
DUT_pTshow:
    mov a,R1
    lcall WriteDigitA
DUT_pU:
    mov a,R2
    lcall WriteDigitA
    Send_Constant_String(#pct_lbl)

    Send_Constant_String(#time_lbl)
    lcall RunTime_To_3Digits
    mov a, R4
    lcall WriteDigitA
    mov a, R5
    lcall WriteDigitA
    mov a, R6
    lcall WriteDigitA
    ret

Show_Error_Message:
    lcall LCD_Clear
    Set_Cursor(1,1)
    Send_Constant_String(#s_error)
    Set_Cursor(2,1)
    Send_Constant_String(#err_msg)
    ret

Display_Status_All:
    lcall HEX_Show_OvenTemp

    mov a, run_flag
    jnz DSA_show
    jb error_demo_flag, DSA_show
    mov a, state
    cjne a, #ERROR_STATE, DSA_done

DSA_show:
    lcall LCD_ShowStateTitle
    jb SW5, DSA_duty
    lcall LCD_ShowTempLine2
    sjmp DSA_done
DSA_duty:
    lcall LCD_ShowDutyLine2
DSA_done:
    ret

;=========================================================
; Return_To_Menu
;=========================================================
Return_To_Menu:
    mov run_flag,#0
    clr paused_flag
    mov state,#0
    clr error_demo_flag
    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    clr duty_mode
    mov param_index,#0
    lcall Set_PWM_Off
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

;=========================================================
; Handle_Key (one-shot)
;=========================================================
Handle_Key:
    mov a, R7

    ; running time reset key '1'
    cjne a, #KEY_TIME_RESET, HK0
    clr a
    mov run_time+0,a
    mov run_time+1,a
    ret
HK0:

    ; ERROR (B): 10 beeps + error screen then menu
    cjne a, #KEY_ERR_BTN, HK_chk_stop
    setb error_demo_flag
    mov state,#ERROR_STATE
    mov run_flag,#0
    clr paused_flag
    lcall Set_PWM_Off
    lcall Show_Error_Message
    lcall Beep_Once
    mov beep_count,#9
    ret

HK_chk_stop:
    ; STOP (C): pauses if running
    cjne a, #KEY_STOP_BTN, HK_chk_start

    mov a, run_flag
    jz  HK_stop_exit_near
    jb  paused_flag, HK_stop_exit_near

    setb paused_flag
    lcall Set_PWM_Off
    ret

HK_stop_exit_near:
    ljmp HK_done

HK_chk_start:
    ; START (D): resume if paused, else toggle run
    cjne a, #KEY_START_BTN, HK_not_control

    jb error_demo_flag, HK_clear_err_to_menu
    jb paused_flag, HK_resume
    sjmp HK_toggle_run

HK_resume:
    clr paused_flag
    ret

HK_clear_err_to_menu:
    lcall Return_To_Menu
    ret

HK_toggle_run:
    mov a, run_flag
    xrl a, #1
    mov run_flag, a

    jz HK_stopped
    mov state, #1
    clr a
    mov seconds+0,a
    mov seconds+1,a
    mov reflow_done_flag,#0
    mov reflow_beeped,#0
    mov temp_stall_secs,#0
    clr paused_flag
    lcall LCD_Clear
    ret

HK_stopped:
    mov state,#0
    clr paused_flag
    lcall Set_PWM_Off
    ret

HK_not_control:
    mov a, run_flag
    jnz HK_done
    jb paused_flag, HK_done
    jb error_demo_flag, HK_done

    ; ENTER (*)
    mov a, R7
    cjne a, #KEY_STAR, HK_clear
    jb duty_mode, HK_save_duty

    lcall Save_Param
    mov a, param_index
    cjne a, #4, HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_save_duty:
    lcall Save_Duty
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    mov a, R7
    cjne a, #KEY_POUND, HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    mov a, R7
    cjne a, #0Ah, HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_done:
    ret

;=========================================================
; MAIN
;=========================================================
main:
    mov SP,#7Fh

    mov P0MOD,#10101111b
    mov P1MOD,#10100010b
    mov P2MOD,#10000010b
    setb P1.5

    clr a
    mov param_index,a
    clr duty_mode

    mov state,#0
    mov prev_state,#0
    mov run_flag,#0

    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    mov reflow_done_flag,#0
    mov reflow_beeped,#0

    clr paused_flag
    clr error_demo_flag

    mov key_lock,#0
    mov last_key,#0

    ; temps
    mov oven_temp+0,#25
    mov oven_temp+1,#0
    mov last_temp_L,#25
    mov last_temp_H,#0

    ; time
    clr a
    mov run_time+0,a
    mov run_time+1,a
    mov seconds+0,a
    mov seconds+1,a

    lcall Clear_Input
    lcall Configure_Keypad_Pins

    ; timers
    lcall Timer0_Init
    lcall Timer1_Init

    ; UART baud on Timer2 (optional but enabled)
    lcall InitSerialPort

    setb PWM
    setb EA

    lcall ELCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    ;=====================================================
    ; SW5 behavior:
    ;   - NOT running AND not error screen: SW5 toggles duty edit page
    ;   - Running: SW5 just changes view (handled in Display_Status_All)
    ;=====================================================
    mov a, run_flag
    jnz SKIP_UI_MODE
    jb error_demo_flag, SKIP_UI_MODE

    jb SW5, SW5_ON
SW5_OFF:
    jb duty_mode, MODE_TO_PARAM
    sjmp SW5_DONE
MODE_TO_PARAM:
    clr duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    sjmp SW5_DONE

SW5_ON:
    jnb duty_mode, MODE_TO_DUTY
    sjmp SW5_DONE
MODE_TO_DUTY:
    setb duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput

SW5_DONE:
SKIP_UI_MODE:

    ;=====================================================
    ; Keypad one-shot handling
    ;=====================================================
    lcall Keypad
    jnc NO_KEY

    mov a, key_lock
    jz  PROCESS_KEY
    mov a, R7
    cjne a, last_key, PROCESS_KEY
    sjmp AFTER_KEY

PROCESS_KEY:
    mov key_lock,#1
    mov a,R7
    mov last_key,a
    lcall Handle_Key

AFTER_KEY:
    sjmp KEY_DONE

NO_KEY:
    mov key_lock,#0
KEY_DONE:

    ;=====================================================
    ; If error screen active: after beeps finish, return to menu
    ;=====================================================
    jb error_demo_flag, ERR_SCREEN
    sjmp RUN_NORMAL

ERR_SCREEN:
    lcall Do_ExtraBeeps
    mov a, beep_count
    jnz SHOW_ONLY
    lcall Return_To_Menu
SHOW_ONLY:
    lcall Display_Status_All
    sjmp loop

RUN_NORMAL:
    ;=====================================================
    ; REAL OVEN TEMP UPDATE (ADC) + STALL + FSM + BEEPS + DISPLAY
    ;=====================================================
    lcall OvenTemp_Update           ; <-- replaces fake temp generator
    lcall Temp_Stall_Check
    lcall FSM_Control

    lcall Beep_On_State_Change
    lcall Do_ExtraBeeps

    lcall Display_Status_All
    sjmp loop

END
