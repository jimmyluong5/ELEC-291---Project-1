;=========================================================
; 7SEG TABLE
;=========================================================
T_7seg:
    DB 0xC0,0xF9,0xA4,0xB0,0x99
    DB 0x92,0x82,0xF8,0x80,0x90

;=========================================================
; UART (Timer2 baud)
;=========================================================
InitSerialPort:
    clr TR2
    mov T2CON,#30h
    mov RCAP2H,#high(T2LOAD)
    mov RCAP2L,#low(T2LOAD)
    setb TR2
    mov SCON,#52h
    ret

;=========================================================
; TIMER0 (AUDIO TONE)
;=========================================================
Timer0_Init:
    ; Timer0 mode 1, preserve Timer1 bits
    mov a, TMOD
    anl a, #0F0h
    orl a, #01h
    mov TMOD, a

    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    setb ET0
    clr  TR0
    clr  SPEAKER
    ret

Timer0_ISR:
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    cpl SPEAKER
    reti

;=========================================================
; TIMER1 (1kHz tick ISR + PWM)
;=========================================================
Timer1_Init:
    ; Timer1 mode 1, preserve Timer0 bits
    mov a, TMOD
    anl a, #0Fh
    orl a, #10h
    mov TMOD, a

    mov TH1,#high(TIMER1_RELOAD)
    mov TL1,#low(TIMER1_RELOAD)

    mov PWM_counter,#0
    mov PWM_duty,#0

    clr a
    mov ms_count+0,a
    mov ms_count+1,a
    mov seconds+0,a
    mov seconds+1,a
    mov run_time+0,a
    mov run_time+1,a

    setb ET1
    setb TR1
    ret

Timer1_ISR:
    mov TH1,#high(TIMER1_RELOAD)
    mov TL1,#low(TIMER1_RELOAD)

    push acc
    push psw

    ; ===== PWM =====
    mov a, PWM_duty
    cjne a, #100, pwm1_normal
    setb PWM
    sjmp pwm1_update_counter

pwm1_normal:
    mov a, PWM_counter
    jnz pwm1_p1
    setb PWM
pwm1_p1:
    cjne a, PWM_duty, pwm1_p2
    clr PWM
pwm1_p2:

pwm1_update_counter:
    mov a, PWM_counter
    inc a
    cjne a, #100, pwm1_p3
    mov a, #0
pwm1_p3:
    mov PWM_counter, a

    ; ===== 1ms tick =====
    inc ms_count+0
    mov a, ms_count+0
    jnz T1_ms_nocarry
    inc ms_count+1
T1_ms_nocarry:

    ; if ms_count != 1000 -> exit
    mov a, ms_count+0
    cjne a, #LOW(1000), T1_exit
    mov a, ms_count+1
    cjne a, #HIGH(1000), T1_exit

    ; ms_count = 0
    clr a
    mov ms_count+0, a
    mov ms_count+1, a

    ; only count time when running and not paused/error screen
    mov a, run_flag
    jz  T1_exit
    jb  paused_flag, T1_exit
    jb  error_demo_flag, T1_exit

    ; seconds++
    inc seconds+0
    mov a, seconds+0
    jnz T1_rt
    inc seconds+1

T1_rt:
    ; run_time++
    inc run_time+0
    mov a, run_time+0
    jnz T1_exit
    inc run_time+1

T1_exit:
    pop psw
    pop acc
    reti

;=========================================================
; DELAYS + BEEPS
;=========================================================
Wait50ms:
    mov R0, #30
W50_L3: mov R1, #74
W50_L2: mov R2, #250
W50_L1: djnz R2, W50_L1
        djnz R1, W50_L2
        djnz R0, W50_L3
    ret

Wait1s:
    mov R4,#20
W1s_lp:
    lcall Wait50ms
    djnz R4,W1s_lp
    ret

Loud_Beep_Once:
    setb TR0
    lcall Wait50ms
    lcall Wait50ms
    clr  TR0
    clr  SPEAKER
    lcall Wait50ms
    ret

Beep_Once:
    setb TR0
    lcall Wait50ms
    clr  TR0
    clr  SPEAKER
    ret

Do_ExtraBeeps:
    mov a, beep_count
    jz  DEB_done
    lcall Loud_Beep_Once
    dec beep_count
DEB_done:
    ret

;=========================================================
; ADC helpers (12-bit -> x)
;=========================================================
Get_ADC12_to_x:
    mov x+3,#0
    mov x+2,#0
    mov x+1, ADC_H
    mov x+0, ADC_L
    ret

;=========================================================
; OvenTemp_Update (once/sec while running, not paused, not error screen)
; - Updates:
;     room_temp16 (2 bytes)
;     oven_temp   (2 bytes)
;=========================================================
OvenTemp_Update:
    ; only run once/sec (ms_count == 0 after tick rollover)
    mov a, ms_count+0
    orl a, ms_count+1
    jnz OT_done

    ; only while actually running
    mov a, run_flag
    jz  OT_done
    jb paused_flag, OT_done
    jb error_demo_flag, OT_done

    ; -------- room temp from ADC ch0 ----------
    mov ADC_C, #0x00
    Wait_Milli_Seconds(#2)
    lcall Get_ADC12_to_x           ; x = adc0 count

    ; room_temp_C = x * ROOM_MAX_C / 4095
    Load_y(ROOM_MAX_C)
    lcall mul32
    Load_y(4095)
    lcall div32

    mov room_temp16+0, x+0
    mov room_temp16+1, x+1

    ; -------- oven delta from ADC ch1 ----------
    mov ADC_C, #0x01
    Wait_Milli_Seconds(#2)
    lcall Get_ADC12_to_x           ; x = adc1 count

    ; oven_delta_C = x * OVEN_DELTA_MAX_C / 4095
    Load_y(OVEN_DELTA_MAX_C)
    lcall mul32
    Load_y(4095)
    lcall div32

    mov oven_delta16+0, x+0
    mov oven_delta16+1, x+1

    ; oven_temp = room_temp + oven_delta (16-bit add)
    mov a, room_temp16+0
    add a, oven_delta16+0
    mov oven_temp+0, a
    mov a, room_temp16+1
    addc a, oven_delta16+1
    mov oven_temp+1, a

OT_done:
    ret

;=========================================================
; INPUT HELPERS
;=========================================================
Clear_Input:
    clr a
    mov bcd+0,a
    mov bcd+1,a
    mov bcd+2,a
    mov bcd+3,a
    mov bcd+4,a
    setb blank_flag
    ret

;=========================================================
; LCD HELPERS
;=========================================================
LCD_Clear:
