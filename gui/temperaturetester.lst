0496            195   Forever:
0496            196       ; --- STEP 1: Read LM4040 Reference (AIN0) ---
0496 53E8F0     197       anl ADCCON0, #0xF0
0499 43E800     198       orl ADCCON0, #0x00 
049C 12043A     199       lcall Read_ADC
049F 8841       200       mov VAL_LM4040+0, R0
04A1 8942       201       mov VAL_LM4040+1, R1
04A3            202   
04A3            203       ; --- STEP 2: Calculate Ambient Temperature (LM335 on AIN7) ---
04A3 53E8F0     204       anl ADCCON0, #0xF0
04A6 43E807     205       orl ADCCON0, #0x07
04A9 12043A     206       lcall Read_ADC
04AC            207       
04AC 8830       208       mov x+0, R0
04AE 8931       209       mov x+1, R1
04B0 753200     210       mov x+2, #0
04B3 753300     211       mov x+3, #0
04B6            212       
04B6            213       ; Convert ADC counts to Kelvin * 100
04B6            214       ; Formula: (ADC_7 * 41040) / ADC_0
04B6 753450     215            mov y+0, #low (41040 % 0x10000) 
04B9 7535A0     215            mov y+1, #high(41040 % 0x10000) 
04BC 753600     215            mov y+2, #low (41040 / 0x10000) 
04BF 753700     215            mov y+3, #high(41040 / 0x10000)  
04C2 120253     216       lcall mul32
04C5 854134     217       mov y+0, VAL_LM4040+0
04C8 854235     218       mov y+1, VAL_LM4040+1
04CB 753600     219       mov y+2, #0
04CE 753700     220       mov y+3, #0
04D1 1202E0     221       lcall div32
04D4            222       
04D4            223       ; Convert Kelvin to Celsius (subtract 2.73)
04D4 7534A4     224            mov y+0, #low (27300 % 0x10000) 
04D7 75356A     224            mov y+1, #high(27300 % 0x10000) 
04DA 753600     224            mov y+2, #low (27300 / 0x10000) 
04DD 753700     224            mov y+3, #high(27300 / 0x10000) 
04E0 1201BF     225       lcall sub32
04E3            226       
04E3            227       ; Store for Cold Junction Compensation (0.01C units)
04E3 85303D     228       mov ambient_temp+0, x+0
04E6 85313E     229       mov ambient_temp+1, x+1
04E9 85323F     230       mov ambient_temp+2, x+2
04EC 853340     231       mov ambient_temp+3, x+3
04EF            232   
04EF            233       ; Display Ambient on Line 1
04EF 1200D9     234       lcall hex2bcd
04F2 1203B5     235       lcall Display_formated_BCD_ambient
04F5            236   
04F5            237       ; --- STEP 3: Calculate Oven Temperature (AIN5) ---
04F5 53E8F0     238       anl ADCCON0, #0xF0
04F8 43E805     239       orl ADCCON0, #0x05
04FB 12043A     240       lcall Read_ADC
04FE            241       
04FE 8830       242       mov x+0, R0
0500 8931       243       mov x+1, R1
0502 753200     244       mov x+2, #0
0505 753300     245       mov x+3, #0
0508            246       
0508            247       ; Convert ADC counts to millivolts (mV) at Op-Amp output
0508 753450     248            mov y+0, #low (41040 % 0x10000) 
050B 7535A0     248            mov y+1, #high(41040 % 0x10000) 
050E 753600     248            mov y+2, #low (41040 / 0x10000) 
0511 753700     248            mov y+3, #high(41040 / 0x10000) 
0514 120253     249       lcall mul32
0517 854134     250       mov y+0, VAL_LM4040+0
051A 854235     251       mov y+1, VAL_LM4040+1
051D 753600     252       mov y+2, #0
0520 753700     253       mov y+3, #0
0523 1202E0     254       lcall div32
0526            255       
0526            256       ; Convert mV to Temperature difference (0.01C resolution)
0526            257       ; Since 1C = 12.3mV (41uV * 300 Gain), we use: (mV * 1000) / 123
0526 7534E8     258            mov y+0, #low (1000 % 0x10000) 
0529 753503     258            mov y+1, #high(1000 % 0x10000) 
052C 753600     258            mov y+2, #low (1000 / 0x10000) 
052F 753700     258            mov y+3, #high(1000 / 0x10000) 
0532 120253     259       lcall mul32
0535 75347B     260            mov y+0, #low (123 % 0x10000) 
0538 753500     260            mov y+1, #high(123 % 0x10000) 
053B 753600     260            mov y+2, #low (123 / 0x10000) 
053E 753700     260            mov y+3, #high(123 / 0x10000) 
0541 1202E0     261       lcall div32
0544            262   
0544            263       ; Add Ambient (Cold Junction Compensation)
0544 853D34     264       mov y+0, ambient_temp+0
0547 853E35     265       mov y+1, ambient_temp+1
054A 853F36     266       mov y+2, ambient_temp+2
054D 854037     267       mov y+3, ambient_temp+3
0550 12019E     268       lcall add32
0553            269   
0553            270       ; Display Oven on Line 2
0553 1200D9     271       lcall hex2bcd
0556 1203E4     272       lcall Display_formated_BCD_oven
0559            273       
0559            274       ; --- STEP 4: UART Output for Data Logging ---
0559 E53A       275       mov a, bcd+2
055B 120426     276       lcall putchar_bcd
055E 742E       277       mov a, #'.'
0560 120413     278       lcall putchar
0563 E539       279       mov a, bcd+1
0565 120426     280       lcall putchar_bcd
0568 12041B     281       lcall Send_newLine
056B            282   
056B            283       ; --- Delay 500ms ---
056B 7AFA       284       mov R2, #250
056D 1203AF     285       lcall waitms
0570 7AFA       286       mov R2, #250
0572 1203AF     287       lcall waitms
0575 020496     288       ljmp Forever
0578            289   EN
