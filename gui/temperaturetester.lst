0349             62   
0349             63   Init_All:
0349             64            ; Configure all the pins for biderectional I/O
0349 75AC00      65            mov     P3M1, #0x00
034C 75AD00      66            mov     P3M2, #0x00
034F 75B300      67            mov     P1M1, #0x00
0352 75B400      68            mov     P1M2, #0x00
0355 75B100      69            mov     P0M1, #0x00
0358 75B200      70            mov     P0M2, #0x00
035B             71            
035B 438E10      72            orl     CKCON, #0x10 ; CLK is the input for timer 1
035E 438780      73            orl     PCON, #0x80 ; Bit SMOD=1, double baud rate
0361 759852      74            mov     SCON, #0x52
0364 53C4DF      75            anl     T3CON, #0b11011111
0367 53890F      76            anl     TMOD, #0x0F ; Clear the configuration bits for timer 1
036A 438920      77            orl     TMOD, #0x20 ; Timer 1 Mode 2
036D 758DF7      78            mov     TH1, #TIMER1_RELOAD ; TH1=TIMER1_RELOAD;
0370 D28E        79            setb TR1
0372             80            
0372             81            ; Using timer 0 for delay functions.  Initialize here:
0372 C28C        82            clr     TR0 ; Stop timer 0
0374 438E08      83            orl     CKCON,#0x08 ; CLK is the input for timer 0
0377 5389F0      84            anl     TMOD,#0xF0 ; Clear the configuration bits for timer 0
037A 438901      85            orl     TMOD,#0x01 ; Timer 0 in Mode 1: 16-bit timer
037D             86            
037D             87            ; Initialize the pins used by the ADC (P1.1, P1.7) as input.
037D 43B382      88            orl     P1M1, #0b10000010
0380 53B47D      89            anl     P1M2, #0b01111101
0383             90            ; Configure P0.4 (AIN5) as Input Only
0383 43B110      91            orl P0M1, #0b00010000
0386 53B2EF      92            anl P0M2, #0b11101111
0389             93            ; Set P1.5 as input 10
0389 43B320      94            orl P1M1, #0b00100000
038C 53B4DF      95            anl P1M2, #0b11011111
038F             96            
038F             97            ; Initialize and start the ADC:
038F 53E8F0      98            anl ADCCON0, #0xF0
0392 43E807      99            orl ADCCON0, #0x07 ; Select channel 7
0395            100            ; AINDIDS select if some pins are analog inputs or digital I/O:
0395 75F600     101            mov AINDIDS, #0x00 ; Disable all analog inputs
0398 43F6A1     102            orl AINDIDS, #0b10100001 ; Bit 0 (AIN0), Bit 5 (AIN5), Bit 7 (AIN7)
039B 43E101     103            orl ADCCON1, #0x01 ; Enable ADC
039E            104            
039E 22         105            ret
039F            106            
039F            107   wait_1ms:
039F C28C       108            clr     TR0 ; Stop timer 0
03A1 C28D       109            clr     TF0 ; Clear overflow flag
03A3 758CBF     110            mov     TH0, #high(TIMER0_RELOAD_1MS)
03A6 758A28     111            mov     TL0,#low(TIMER0_RELOAD_1MS)
03A9 D28C       112            setb TR0
03AB 308DFD     113            jnb     TF0, $ ; Wait for overflow
03AE 22         114            ret
03AF            115   
03AF            116   ; Wait the number of miliseconds in R2
03AF            117   waitms:
03AF 12039F     118            lcall wait_1ms
03B2 DAFB       119            djnz R2, waitms
03B4 22         120            ret
03B5            121   
03B5            122   ; We can display a number any way we want.  In this case with six sig fig
03B5            123   Display_formated_BCD_ambient:
03B5 C0E0       124            push acc
03B7 7401       124            mov a, #1
03B9 14         124            dec a
03BA 1200BE     124            lcall ?Set_Cursor_1 ; Select column and row
03BD D0E0       124            pop acc
03BF C000       125            push ar0
03C1 A83A       125            mov r0, bcd+2
03C3 1200C3     125            lcall ?Display_BCD
03C6 D000       125            pop ar0
03C8 C000       126            push ar0
03CA A839       126            mov r0, bcd+1
03CC 1200C3     126            lcall ?Display_BCD
03CF D000       126            pop ar0
03D1 C0E0       127            push acc
03D3 742E       127            mov a, #'.'
03D5 120074     127            lcall ?WriteData
03D8 D0E0       127            pop acc
03DA C000       128            push ar0
03DC A838       128            mov r0, bcd+0
03DE 1200C3     128            lcall ?Display_BCD
03E1 D000       128            pop ar0
03E3 22         129            ret
03E4            130            
03E4            131   Display_formated_BCD_oven:
03E4 C0E0       132            push acc
03E6 7401       132            mov a, #1
03E8 14         132            dec a
03E9 1200BC     132            lcall ?Set_Cursor_2 ; Select column and row
03EC D0E0       132            pop acc
03EE C000       133            push ar0
03F0 A83A       133            mov r0, bcd+2
03F2 1200C3     133            lcall ?Display_BCD
03F5 D000       133            pop ar0
03F7 C000       134            push ar0
03F9 A839       134            mov r0, bcd+1
03FB 1200C3     134            lcall ?Display_BCD
03FE D000       134            pop ar0
0400 C0E0       135            push acc
0402 742E       135            mov a, #'.'
0404 120074     135            lcall ?WriteData
0407 D0E0       135            pop acc
0409 C000       136            push ar0
040B A838       136            mov r0, bcd+0
040D 1200C3     136            lcall ?Display_BCD
0410 D000       136            pop ar0
0412 22         137            ret
0413            138   
0413            139   putchar:
0413 3099FD     140            jnb TI, putchar
0416 C299       141            clr TI
0418 F599       142            mov SBUF, a
041A 22         143            ret
041B            144   
041B            145   Send_newLine:
041B 740D       146            mov a, #0x0D ; 13 in hex
041D 120413     147            lcall putchar
0420 740A       148            mov a, #0x0A ; 10 in hex
0422 120413     149            lcall putchar
0425 22         150            ret
0426            151            
0426            152   putchar_bcd:
0426 C0E0       153            push acc
0428 C4         154            swap a
0429 540F       155            anl a, #0x0f
042B 2430       156            add a, #'0'
042D 120413     157            lcall putchar
0430 D0E0       158            pop acc
0432 540F       159            anl a, #0x0f
0434 2430       160            add a, #'0'
0436 120413     161            lcall putchar
0439 22         162            ret
043A            163   
043A            164   Read_ADC:
043A C2EF       165            clr ADCF
043C D2EE       166            setb ADCS ;  ADC start trigger signal
043E 30EFFD     167            jnb ADCF, $ ; Wait for conversion complete
0441            168            
0441            169            ; Read the ADC result and store in [R1, R0]
0441 E5C2       170            mov a, ADCRL
0443 540F       171            anl a, #0x0f
0445 F8         172            mov R0, a
0446 E5C3       173            mov a, ADCRH
0448 C4         174            swap a
0449 C0E0       175            push acc
044B 540F       176            anl a, #0x0f
044D F9         177            mov R1, a
044E D0E0       178            pop acc
0450 54F0       179            anl a, #0xf0
0452 48         180            orl a, R0
0453 F8         181            mov R0, A
0454 22         182            ret
0455            183   
0455            184   main:
0455 75817F     185            mov sp, #0x7f
0458 120349     186            lcall Init_All
045B 12007E     187            lcall LCD_4BIT
045E            188            
045E            189            ; initial messages in LCD
045E C0E0       190            push acc
0460 7401       190            mov a, #1
0462 14         190            dec a
0463 1200BE     190            lcall ?Set_Cursor_1 ; Select column and row
0466 D0E0       190            pop acc
0468 C083       191            push dph
046A C082       191            push dpl
046C C0E0       191            push acc
046E 900003     191            mov dptr, #lineA
0471 1200B1     191            lcall ?Send_Constant_String
0474 D0E0       191            pop acc
0476 D082       191            pop dpl
0478 D083       191            pop dph
047A C0E0       192            push acc
047C 7401       192            mov a, #1
047E 14         192            dec a
047F 1200BC     192            lcall ?Set_Cursor_2 ; Select column and row
0482 D0E0       192            pop acc
0484 C083       193            push dph
0486 C082       193            push dpl
0488 C0E0       193            push acc
048A 900014     193            mov dptr, #lineO
048D 1200B1     193            lcall ?Send_Constant_String
0490 D0E0       193            pop acc
0492 D082       193            pop dpl
0494 D083       193            pop dph
