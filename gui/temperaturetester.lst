0025             35   cseg
0025             36   ; PINOUT
0025             37   LCD_RS equ P1.3
0025             38   LCD_E  equ P1.4
0025             39   LCD_D4 equ P0.0
0025             40   LCD_D5 equ P0.1
0025             41   LCD_D6 equ P0.2
