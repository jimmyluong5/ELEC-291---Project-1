$NOLIST
$MODMAX10
$LIST

;=========================================================
; CLOCK + TIMERS
;=========================================================
CLK           EQU 33333333

TIMER0_RATE   EQU 4096
TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE))))

TIMER2_RATE   EQU 15
TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))

SOUND_OUT     equ P2.1
PWM           equ P2.7

KEY_STAR      EQU 0x0E      ; *
KEY_POUND     EQU 0x0F      ; #

; LCD value field start column (after "SOAK Tmp: ")
VALUE_COL     EQU 11        ; value occupies col 11..13


org 0x0000
    ljmp main
org 0x000B
    ljmp Timer0_ISR
org 0x002B
    ljmp Timer2_ISR

;data
dseg at 0x30
PWM_counter:  ds 1
PWM_duty:     ds 1

bcd:          ds 5          ; packed BCD digit buffer (typed digits go here)
param_index:  ds 1          ; 0..4

;parameters that we enter.
soak_temp:    ds 2
soak_time:    ds 2
reflow_temp:  ds 2
reflow_time:  ds 2

bseg
blank_flag:   dbit 1         ; 1 = nothing typed yet

cseg

;lcd wiring
ELCD_RS equ P0.0
ELCD_E  equ P0.2
ELCD_D4 equ P0.7
ELCD_D5 equ P0.5
ELCD_D6 equ P0.3
ELCD_D7 equ P0.1

$NOLIST
$include(LCD_4bit_DE10Lite_no_RW.inc)
$include(Read_keypad.inc)
$LIST

;strings
soaktemp_str:    db 'SOAK Tmp: ',0
soaktime_str:    db 'SOAK time:',0
reflowtemp_str:  db 'REFL Tmp: ',0
reflowtime_str:  db 'REFL time:',0
profile_ready:   db 'PROFILE READY',0

help_str:        db '0-999*=ENT#=CLR',0

;7seg table
T_7seg:
    DB 0xC0,0xF9,0xA4,0xB0,0x99
    DB 0x92,0x82,0xF8,0x80,0x90

;timer0
Timer0_Init:
    mov TMOD,#01h
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    setb ET0
    setb TR0
    ret

Timer0_ISR:
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    cpl SOUND_OUT
    reti

;timer 2 with pwm integration
Timer2_Init:
    mov T2CON,#0
    mov TH2,#high(TIMER2_RELOAD)
    mov TL2,#low(TIMER2_RELOAD)
    mov RCAP2H,#high(TIMER2_RELOAD)
    mov RCAP2L,#low(TIMER2_RELOAD)

    mov PWM_counter,#0
    mov PWM_duty,#0

    setb ET2
    setb TR2
    ret

Timer2_ISR:
    clr TF2
    push acc
    push psw

    mov a,PWM_counter
    jnz p1x
    setb PWM
p1x:
    cjne a,PWM_duty,p2x
    clr PWM
p2x:
    inc a
    cjne a,#100,p3x
    mov a,#0
p3x:
    mov PWM_counter,a

    pop psw
    pop acc
    reti


Clear_Input:
    clr a
    mov bcd+0,a
    mov bcd+1,a
    mov bcd+2,a
    mov bcd+3,a
    mov bcd+4,a
    setb blank_flag
    ret

;lcd functions
LCD_Clear:
    WriteCommand(#01h)
    Wait_Milli_Seconds(#2)
    ret

; Clear the 3-digit value field on line 1 (VALUE_COL..VALUE_COL+2)
LCD_ClearValueArea:
    Set_Cursor(1,VALUE_COL)
    WriteData(#' ')
    WriteData(#' ')
    WriteData(#' ')
    ret

; Clear line 2 (16 chars)
LCD_ClearLine2:
    Set_Cursor(2,1)
    mov R0,#16
L2C1:
    WriteData(#' ')
    djnz R0,L2C1
    ret


; GET LSD 3 DIGITS FROM BCD INTO R0/R1/R2
; R0=hundreds, R1=tens, R2=units
Get_LSD3:
    mov a,bcd+0
    anl a,#0Fh
    mov R2,a

    mov a,bcd+0
    swap a
    anl a,#0Fh
    mov R1,a

    mov a,bcd+1
    anl a,#0Fh
    mov R0,a
    ret


; WriteDigitA: prints A (0..9) as ASCII on LCD
WriteDigitA:
    cjne a,#0,WD1
    WriteData(#'0')  ;0
    ret
WD1: cjne a,#1,WD2
    WriteData(#'1')
    ret
WD2: cjne a,#2,WD3
    WriteData(#'2')
    ret
WD3: cjne a,#3,WD4
    WriteData(#'3')
    ret
WD4: cjne a,#4,WD5
    WriteData(#'4')
    ret
WD5: cjne a,#5,WD6
    WriteData(#'5')
    ret
WD6: cjne a,#6,WD7
    WriteData(#'6')
    ret
WD7: cjne a,#7,WD8
    WriteData(#'7')
    ret
WD8: cjne a,#8,WD9
    WriteData(#'8')
    ret
WD9:
    WriteData(#'9')
    ret


; LCD_ShowInput: right-aligned 3-char field
; 5 -> "  5", 90 -> " 90", 150 -> "150"
LCD_ShowInput:
    lcall LCD_ClearValueArea
    jb blank_flag, LSI_done

    lcall Get_LSD3

    mov a,R0
    jnz LSI_3

    mov a,R1
    jnz LSI_2

; 1 digit
LSI_1:
    Set_Cursor(1,VALUE_COL+2)
    mov a,R2
    lcall WriteDigitA
    sjmp LSI_done

; 2 digits
LSI_2:
    Set_Cursor(1,VALUE_COL+1)
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA
    sjmp LSI_done

; 3 digits
LSI_3:
    Set_Cursor(1,VALUE_COL)
    mov a,R0
    lcall WriteDigitA
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA

LSI_done:
    ret

; HEX_ShowInput (HEX2 HEX1 HEX0) no leading zeros
HEX_ShowInput:
    mov dptr,#T_7seg
    jb blank_flag, HX_blank

    lcall Get_LSD3

    mov a,R0
    jz HX_h_blank
    movc a,@a+dptr
    mov HEX2,a
    sjmp HX_tens
HX_h_blank:
    mov HEX2,#0FFh

HX_tens:
    mov a,R1
    jnz HX_t_show
    mov a,R0
    jz  HX_t_blank
HX_t_show:
    mov a,R1
    movc a,@a+dptr
    mov HEX1,a
    sjmp HX_units
HX_t_blank:
    mov HEX1,#0FFh

HX_units:
    mov a,R2
    movc a,@a+dptr
    mov HEX0,a
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret

HX_blank:
    mov HEX0,#0FFh
    mov HEX1,#0FFh
    mov HEX2,#0FFh
    mov HEX3,#0FFh
    mov HEX4,#0FFh
    mov HEX5,#0FFh
    ret


; LCD_Update screens for each parameter
LCD_Update:
    lcall LCD_Clear
    lcall LCD_ClearLine2

    mov a,param_index
    cjne a,#0,L1y
    Set_Cursor(1,1)
    Send_Constant_String(#soaktemp_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L1y:
    cjne a,#1,L2y
    Set_Cursor(1,1)
    Send_Constant_String(#soaktime_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L2y:
    cjne a,#2,L3y
    Set_Cursor(1,1)
    Send_Constant_String(#reflowtemp_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L3y:
    cjne a,#3,L4y
    Set_Cursor(1,1)
    Send_Constant_String(#reflowtime_str)
    Set_Cursor(2,1)
    Send_Constant_String(#help_str)
    lcall LCD_ShowInput
    ret
L4y:
    Set_Cursor(1,1)
    Send_Constant_String(#profile_ready)
    ;lcall LCD_ClearValueArea
    ret


; saving parameters
Save_Param:
    mov a,param_index
    cjne a,#0,s1
    mov soak_temp+0,bcd+0
    mov soak_temp+1,bcd+1
    ret
s1:
    cjne a,#1,s2
    mov soak_time+0,bcd+0
    mov soak_time+1,bcd+1
    ret
s2:
    cjne a,#2,s3
    mov reflow_temp+0,bcd+0
    mov reflow_temp+1,bcd+1
    ret
s3:
    mov reflow_time+0,bcd+0
    mov reflow_time+1,bcd+1
    ret


; handle keypad input (R7 keycode)

Handle_Key:
    mov a,R7

    ; ENTER (*)
    cjne a,#KEY_STAR,HK_clear ;if not star go to this label
    lcall Save_Param ;we click the star we save the parameter into the variable, then display it into the hex.
    mov a,param_index
    cjne a,#4,HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret
HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    ; CLEAR (#) -> CLEAR LCD VALUE FIELD TOO
    cjne a,#KEY_POUND,HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    ; accept only 0..9
    mov a,R7
    cjne a,#0Ah,HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret


;main function
main:
    mov SP,#7Fh

	;set the pins to output
    mov P0MOD,#10101111b
    mov P1MOD,#10000010b
    mov P2MOD,#10000010b
	
	;set the parameters to 0.
    clr a
    mov param_index,a

	;clear all inputs
    lcall Clear_Input
    
    ;initialize the keypad.
    lcall Configure_Keypad_Pins

	;call timers
    lcall Timer0_Init
    lcall Timer2_Init
    
    ;turn on the PWM
    setb PWM
    
    ;turn on global interrupts.
    setb EA

    lcall ELCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    lcall Keypad
    jnc loop
    lcall Handle_Key
    sjmp loop

END
