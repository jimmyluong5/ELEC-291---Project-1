$NOLIST
$MODMAX10
$LIST

;=========================================================
; CLOCK + TIMERS
;=========================================================
CLK           EQU 33333333

TIMER0_RATE   EQU 4096
TIMER0_RELOAD EQU ((65536-(CLK/(12*TIMER0_RATE))))

TIMER2_RATE   EQU 15
TIMER2_RELOAD EQU ((65536-(CLK/(12*TIMER2_RATE))))

SOUND_OUT     equ P2.1
PWM           equ P2.7

; Keypad codes (your mapping)
KEY_STAR      EQU 0x0E      ; * = ENTER (apply duty)
KEY_POUND     EQU 0x0F      ; # = CLEAR

;=========================================================
; VECTORS
;=========================================================
org 0x0000
    ljmp main

org 0x000B
    ljmp Timer0_ISR

org 0x002B
    ljmp Timer2_ISR

;=========================================================
; DATA
;=========================================================
dseg at 0x30
PWM_counter:  ds 1          ; 0..99
PWM_duty:     ds 1          ; 0..100
bcd:          ds 5          ; packed BCD digits (10 digits total)

bseg
half_seconds_flag: dbit 1

cseg

;=========================================================
; LCD wiring (your library uses these)
;=========================================================
ELCD_RS equ P1.7
ELCD_E  equ P1.1
ELCD_D4 equ P0.7
ELCD_D5 equ P0.5
ELCD_D6 equ P0.3
ELCD_D7 equ P0.1

$NOLIST
$include(LCD_4bit_DE10Lite_no_RW.inc)
$LIST

;=========================================================
; LCD constant strings
;=========================================================
LCD_Line1: db "Duty: ",0
LCD_blank: db "   ",0       ; three spaces

;=========================================================
; TIMER0: optional sound
;=========================================================
Timer0_Init:
    mov TMOD,#01h
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    setb ET0
    setb TR0
    ret

Timer0_ISR:
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    cpl SOUND_OUT
    reti

;=========================================================
; TIMER2: PWM update
;=========================================================
Timer2_Init:
    mov T2CON,#0
    mov TH2,#high(TIMER2_RELOAD)
    mov TL2,#low(TIMER2_RELOAD)
    mov RCAP2H,#high(TIMER2_RELOAD)
    mov RCAP2L,#low(TIMER2_RELOAD)

    mov PWM_counter,#0
    mov PWM_duty,#0

    setb ET2
    setb TR2
    ret

Timer2_ISR:
    clr TF2
    push acc
    push psw

    mov a, PWM_counter

    ; start of period => PWM high
    jnz pwm_not_zero
    setb PWM
pwm_not_zero:

    ; drop when counter == duty
    cjne a, PWM_duty, pwm_skip
    clr PWM
pwm_skip:

    inc a
    cjne a, #100, pwm_store
    mov a, #0
pwm_store:
    mov PWM_counter, a

    pop psw
    pop acc
    reti

;=========================================================
; 7-SEG DISPLAY (your code)
;=========================================================
myLUT:
    DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99
    DB 0x92, 0x82, 0xF8, 0x80, 0x90
    DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E

showBCD MAC
    mov A, %0
    anl a, #0fh
    movc A, @A+dptr
    mov %1, A

    mov A, %0
    swap a
    anl a, #0fh
    movc A, @A+dptr
    mov %2, A
ENDMAC

Display:
    mov dptr, #myLUT

    mov a, bcd+3
    orl a, bcd+4
    jz Display_L1
    setb LEDRA.7
    sjmp Display_L2
Display_L1:
    clr LEDRA.7
Display_L2:

    jnb key.3, Display_high_digits
    showBCD(bcd+0, HEX0, HEX1)
    showBCD(bcd+1, HEX2, HEX3)
    sjmp Display_end

Display_high_digits:
    showBCD(bcd+3, HEX0, HEX1)
    showBCD(bcd+4, HEX2, HEX3)
    mov HEX4, #0xff
    mov HEX5, #0xff

Display_end:
    ret

;=========================================================
; SHIFT DIGITS LEFT/RIGHT (your code)
;=========================================================
MYRLC MAC
    mov a, %0
    rlc a
    mov %0, a
ENDMAC

Shift_Digits_Left:
    mov R0, #4
Shift_Digits_Left_L0:
    clr c
    MYRLC(bcd+0)
    MYRLC(bcd+1)
    MYRLC(bcd+2)
    MYRLC(bcd+3)
    MYRLC(bcd+4)
    djnz R0, Shift_Digits_Left_L0

    mov a, R7
    orl a, bcd+0
    mov bcd+0, a
    ret

MYRRC MAC
    mov a, %0
    rrc a
    mov %0, a
ENDMAC

Shift_Digits_Right:
    mov R0, #4
Shift_Digits_Right_L0:
    clr c
    MYRRC(bcd+4)
    MYRRC(bcd+3)
    MYRRC(bcd+2)
    MYRRC(bcd+1)
    MYRRC(bcd+0)
    djnz R0, Shift_Digits_Right_L0
    ret

;=========================================================
; KEYPAD SUPPORT (your code)
;=========================================================
Wait25ms:
    mov R0, #15
L3x: mov R1, #74
L2x: mov R2, #250
L1x: djnz R2, L1x
     djnz R1, L2x
     djnz R0, L3x
     ret

CHECK_COLUMN MAC
    jb %0, CHECK_COL_%M
    mov R7, %1
    jnb %0, $
    setb c
    ret
CHECK_COL_%M:
ENDMAC

Configure_Keypad_Pins:
    orl P1MOD, #0b_01010100
    orl P2MOD, #0b_00000001
    anl P2MOD, #0b_10101011
    anl P3MOD, #0b_11111110
    ret

ROW1 EQU P1.2
ROW2 EQU P1.4
ROW3 EQU P1.6
ROW4 EQU P2.0
COL1 EQU P2.2
COL2 EQU P2.4
COL3 EQU P2.6
COL4 EQU P3.0

Keypad:
    jb KEY.1, keypad_L0
    lcall Wait25ms
    jb KEY.1, keypad_L0
    jnb KEY.1, $
    lcall Shift_Digits_Right
    clr c
    ret

keypad_L0:
    clr ROW1
    clr ROW2
    clr ROW3
    clr ROW4
    mov c, COL1
    anl c, COL2
    anl c, COL3
    anl c, COL4
    jnc Keypad_Debounce
    clr c
    ret

Keypad_Debounce:
    lcall Wait25ms
    mov c, COL1
    anl c, COL2
    anl c, COL3
    anl c, COL4
    jnc Keypad_Key_Code
    clr c
    ret

Keypad_Key_Code:
    setb ROW1
    setb ROW2
    setb ROW3
    setb ROW4

keypad_default:
    clr ROW1
    nop
    nop
    CHECK_COLUMN(COL1, #01H)
    CHECK_COLUMN(COL2, #02H)
    CHECK_COLUMN(COL3, #03H)
    CHECK_COLUMN(COL4, #0AH)
    setb ROW1
    nop
    nop

    clr ROW2
    CHECK_COLUMN(COL1, #04H)
    CHECK_COLUMN(COL2, #05H)
    CHECK_COLUMN(COL3, #06H)
    CHECK_COLUMN(COL4, #0BH)
    setb ROW2

    clr ROW3
    CHECK_COLUMN(COL1, #07H)
    CHECK_COLUMN(COL2, #08H)
    CHECK_COLUMN(COL3, #09H)
    CHECK_COLUMN(COL4, #0CH)
    setb ROW3

    clr ROW4
    CHECK_COLUMN(COL1, #0EH) ; * ENTER
    CHECK_COLUMN(COL2, #00H) ; 0
    CHECK_COLUMN(COL3, #0FH) ; # CLEAR
    CHECK_COLUMN(COL4, #0DH) ; D
    setb ROW4

    clr c
    ret

;=========================================================
; Convert LSD 3 digits -> PWM_duty (0..100)
;=========================================================
Apply_Duty_From_BCD_LSD3:
    mov a, bcd+1
    anl a, #0Fh
    mov r5, a           ; hundreds

    mov a, bcd+0
    swap a
    anl a, #0Fh
    mov r6, a           ; tens

    mov a, bcd+0
    anl a, #0Fh
    mov r7, a           ; units

    ; hundreds >= 2 => clamp 100
    mov a, r5
    cjne a, #2, chk_h1
    sjmp clamp_100
chk_h1:
    jnc clamp_100

    ; if hundreds==1 then must be 100 only
    mov a, r5
    jz compute_0_99
    mov a, r6
    orl a, r7
    jnz clamp_100
    mov PWM_duty, #100
    ret

compute_0_99:
    mov a, r6
    mov b, #10
    mul ab
    add a, r7
    mov PWM_duty, a
    ret

clamp_100:
    mov PWM_duty, #100
    ret

;=========================================================
; LCD helpers: show duty on LCD
;=========================================================
; Displays "Duty: XYZ" where XYZ is 0..100 from PWM_duty
LCD_Show_Duty:
    ; Line 1, col 1: "Duty: "
    Set_Cursor(1,1)
    Send_Constant_String(#LCD_Line1)

    ; Now print 3 digits at col 7 (after "Duty: ")
    Set_Cursor(1,7)

    ; hundreds digit
    mov a, PWM_duty
    mov b, #100
    div ab              ; A = hundreds (0/1), B = remainder 0..99
    add a, #'0'
    lcall ELCD_PutChar  ; from LCD lib

    ; tens digit
    mov a, b            ; remainder
    mov b, #10
    div ab              ; A = tens, B = units
    add a, #'0'
    lcall ELCD_PutChar

    ; units digit
    mov a, b
    add a, #'0'
    lcall ELCD_PutChar
    ret

; Clears the duty digits area on LCD (keeps "Duty: ")
LCD_Clear_DutyDigits:
    Set_Cursor(1,7)
    Send_Constant_String(#LCD_blank)
    ret

;=========================================================
; Handle keycode in R7
; * ENTER -> compute duty + show on LCD
; # CLEAR -> clear bcd + duty + clear LCD digits
; digits 0..9 -> shift in
;=========================================================
Handle_Keycode:
    mov a, R7

    ; ENTER '*'
    cjne a, #KEY_STAR, chk_clear
    lcall Apply_Duty_From_BCD_LSD3
    lcall LCD_Show_Duty
    ret

chk_clear:
    ; CLEAR '#'
    cjne a, #KEY_POUND, chk_digit

    clr a
    mov bcd+0, a
    mov bcd+1, a
    mov bcd+2, a
    mov bcd+3, a
    mov bcd+4, a
    mov PWM_duty, a
    lcall LCD_Clear_DutyDigits
    ret

chk_digit:
    ; accept only 0..9
    mov a, R7
    cjne a, #0Ah, maybe_ok
    sjmp done_key
maybe_ok:
    jc digit_ok
    sjmp done_key
digit_ok:
    lcall Shift_Digits_Left
done_key:
    ret

;=========================================================
; MAIN
;=========================================================
main:
    mov SP, #7FH

    ; ports for LCD + output pins
    mov P0MOD, #10101010b
    mov P1MOD, #10000010b
    mov P2MOD, #10000010b

    ; init vars
    clr a
    mov PWM_counter, a
    mov PWM_duty, a
    mov bcd+0, a
    mov bcd+1, a
    mov bcd+2, a
    mov bcd+3, a
    mov bcd+4, a

    ; init HW
    lcall Configure_Keypad_Pins
    lcall Timer0_Init
    lcall Timer2_Init

    setb PWM
    setb EA

    ; init LCD + show initial duty
    lcall ELCD_4BIT
    lcall LCD_Show_Duty

forever:
    lcall Keypad
    jnc just_show

    ; key pressed -> R7 has code
    lcall Handle_Keycode

just_show:
    lcall Display
    sjmp forever

END
