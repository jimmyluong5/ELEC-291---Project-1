;=========================================================
; GET LSD 3 DIGITS FROM BCD INTO R0/R1/R2
;=========================================================
Get_LSD3:
    mov a,bcd+0
    anl a,#0Fh
    mov R2,a

    mov a,bcd+0
    swap a
    anl a,#0Fh
    mov R1,a

    mov a,bcd+1
    anl a,#0Fh
    mov R0,a
    ret

;=========================================================
; WriteDigitA
;=========================================================
WriteDigitA:
    cjne a,#0,WD1
    WriteData(#'0')
    ret
WD1: cjne a,#1,WD2
    WriteData(#'1')
    ret
WD2: cjne a,#2,WD3
    WriteData(#'2')
    ret
WD3: cjne a,#3,WD4
    WriteData(#'3')
    ret
WD4: cjne a,#4,WD5
    WriteData(#'4')
    ret
WD5: cjne a,#5,WD6
    WriteData(#'5')
    ret
WD6: cjne a,#6,WD7
    WriteData(#'6')
    ret
WD7: cjne a,#7,WD8
    WriteData(#'7')
    ret
WD8: cjne a,#8,WD9
    WriteData(#'8')
    ret
WD9:
    WriteData(#'9')
    ret

