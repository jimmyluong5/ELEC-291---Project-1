;=========================================================
; UART (Timer2 baud) - FIXED + CLEAN
;=========================================================
;=========================================================
; UART (Timer2 baud) - FIXED + CLEAN
;=========================================================
InitSerialPort:
    clr TR2
    mov T2CON,#30h
    mov RCAP2H,#high(T2LOAD)
    mov RCAP2L,#low(T2LOAD)
    setb TR2
    mov SCON,#52h
    ret

UART_SendByte:
    clr TI
    mov SBUF, A
UART_WaitTI:
    jnb TI, UART_WaitTI
    ret

UART_SendCRLF:
    mov a, #13
    lcall UART_SendByte
    mov a, #10
    lcall UART_SendByte
    ret

UART_SendDigit:
    add a, #'0'
    lcall UART_SendByte
    ret

UART_Print_OvenTemp:
    ; print at ms_count == 0 OR 500 (2 Hz)
    
    ; ---- check ms_count == 0 ----
    mov a, ms_count+0
    orl a, ms_count+1
    jz  UPO_DO_PRINT

    ; ---- check ms_count == 500 ----
    mov a, ms_count+0
    cjne a, #LOW(500), UPO_done
    mov a, ms_count+1
    cjne a, #HIGH(500), UPO_done

UPO_DO_PRINT:
    ; -------- print temperature without leading zeros --------
    lcall Bin16_To_3Digits   ; oven_temp -> R0 R1 R2 (hundreds, tens, units)

    ; Check hundreds digit
    mov a, R0
    jz  UPO_check_tens       ; Skip hundreds if zero
    
    ; Print all 3 digits (e.g., "123")
    lcall UART_SendDigit
    mov a, R1
    lcall UART_SendDigit
    mov a, R2
    lcall UART_SendDigit
    sjmp UPO_print_comma

UPO_check_tens:
    ; Hundreds is zero, check tens
    mov a, R1
    jz  UPO_units_only       ; Skip tens if zero
    
    ; Print tens and units (e.g., "25")
    lcall UART_SendDigit
    mov a, R2
    lcall UART_SendDigit
    sjmp UPO_print_comma

UPO_units_only:
    ; Print only units (e.g., "5")
    mov a, R2
    lcall UART_SendDigit

UPO_print_comma:
    mov a, #','
    lcall UART_SendByte

    ; -------- print state (single digit) --------
    mov a, state
    add a, #'0'
    lcall UART_SendByte

    ; newline
    lcall UART_SendCRLF

UPO_done:
    ret

;=========================================================
; TIMER0 (AUDIO TONE)
;=========================================================
Timer0_Init:
    mov a, TMOD
    anl a, #0F0h
    orl a, #01h
    mov TMOD, a

    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    setb ET0
    clr  TR0
    clr  SPEAKER
    ret

Timer0_ISR:
    mov TH0,#high(TIMER0_RELOAD)
    mov TL0,#low(TIMER0_RELOAD)
    cpl SPEAKER
    reti

;=========================================================
; TIMER1 (1kHz tick ISR + PWM)
;=========================================================
Timer1_Init:
    mov a, TMOD
    anl a, #0Fh
    orl a, #10h
    mov TMOD, a

    mov TH1,#high(TIMER1_RELOAD)
    mov TL1,#low(TIMER1_RELOAD)

    mov PWM_counter,#0
    mov PWM_duty,#0

    clr a
    mov ms_count+0,a
    mov ms_count+1,a
    mov seconds+0,a
    mov seconds+1,a
    mov run_time+0,a
    mov run_time+1,a

    setb ET1
    setb TR1
    ret

Timer1_ISR:
    mov TH1,#high(TIMER1_RELOAD)
    mov TL1,#low(TIMER1_RELOAD)

    push acc
    push psw

    ; ===== PWM (ACTIVE-LOW LOGIC AS YOUR ORIGINAL FILE) =====
    ; PWM_duty is 0..100
    ; - at counter==0: clr PWM
    ; - at counter==duty: setb PWM
    ; That means ON-time is duty% of the 0..99 window, but ON is when PWM=0.
    mov a, PWM_duty
    cjne a, #100, pwm1_normal
    clr PWM
    sjmp pwm1_update_counter

pwm1_normal:
    mov a, PWM_counter
    jnz pwm1_p1
    clr PWM
pwm1_p1:
    cjne a, PWM_duty, pwm1_p2
    setb PWM
pwm1_p2:

pwm1_update_counter:
    mov a, PWM_counter
    inc a
    cjne a, #100, pwm1_p3
    mov a, #0
pwm1_p3:
    mov PWM_counter, a

    ; ===== 1ms tick =====
    inc ms_count+0
    mov a, ms_count+0
    jnz T1_ms_nocarry
    inc ms_count+1
T1_ms_nocarry:

    mov a, ms_count+0
    cjne a, #LOW(1000), T1_exit
    mov a, ms_count+1
    cjne a, #HIGH(1000), T1_exit

    clr a
    mov ms_count+0, a
    mov ms_count+1, a

    mov a, run_flag
    jz  T1_exit
    jb  paused_flag, T1_exit
    jb  error_demo_flag, T1_exit

    inc seconds+0
    mov a, seconds+0
    jnz T1_rt
    inc seconds+1

T1_rt:
    inc run_time+0
    mov a, run_time+0
    jnz T1_exit
    inc run_time+1

T1_exit:
    pop psw
    pop acc
    reti

;=========================================================
; DELAYS + BEEPS
;=========================================================
Wait50ms:
    mov R0, #30
W50_L3: mov R1, #74
W50_L2: mov R2, #250
W50_L1: djnz R2, W50_L1
        djnz R1, W50_L2
        djnz R0, W50_L3
    ret

Wait1s:
    mov R4,#20
W1s_lp:
    lcall Wait50ms
    djnz R4,W1s_lp
    ret

Loud_Beep_Once:
    setb TR0
    lcall Wait50ms
    lcall Wait50ms
    clr  TR0
    clr  SPEAKER
    lcall Wait50ms
    lcall Wait50ms
    ret

Beep_Once:
    setb TR0
    lcall Wait50ms
    clr  TR0
    clr  SPEAKER
    ret

Do_ExtraBeeps:
    mov a, beep_count
    jz  DEB_done
    ;lcall Loud_Beep_Once
    lcall Beep_Once
    dec beep_count
DEB_done:
    ret

;=========================================================
; ADC helpers
;=========================================================
Get_ADC12_to_x:
    mov x+3,#0
    mov x+2,#0
    mov x+1, ADC_H
    mov x+0, ADC_L
    ret

;=========================================================
; Read volt_ref once (ADC channel 2) at startup
;=========================================================
Init_VoltRef:
    mov ADC_C, #0x02
    Wait_Milli_Seconds(#2)
    lcall Get_ADC12_to_x
    mov volt_ref+0, x+0
    mov volt_ref+1, x+1
    ret

;=========================================================
; OvenTemp_Update (REPLACED with your calibrated math)
; - reads ADC0 -> rm_temp (stored 32-bit)
; - reads ADC1 -> calibrated oven computation
; - stores final integer Celsius into oven_temp (16-bit)
;=========================================================
;=========================================================
; OvenTemp_Update (once/sec while running, not paused/error)
; Uses your hard-coded calibration pipeline (NO ROOM_MAX_C)
;
; Requires these variables exist in dseg:
;   ms_count (2), run_flag (1), paused_flag (bit), error_demo_flag (bit)
;   volt_ref (2), rm_temp (4), ov_temp (4), oven_temp (2)
;   x (4), y (4)
;=========================================================
;=========================================================
; OvenTemp_Update (2 Hz: ms_count == 0 or 500)
; - skips when paused or in error screen
; - runs your full calibrated pipeline
;=========================================================
OvenTemp_Update:
    ; ---------- Check if it's time to update (ms_count == 0 OR 500) ----------
    mov a, ms_count+0
    orl a, ms_count+1
    jz  OT_time_ok          ; ms_count == 0, proceed
    
    ; Check if ms_count == 500
    mov a, ms_count+0
    cjne a, #LOW(500), OT_donelabel
    mov a, ms_count+1
    cjne a, #HIGH(500), OT_donelabel
    ; Fall through if ms_count == 500
OT_donelabel:
ljmp OT_done
OT_time_ok:
    ; Check if we should skip (paused or error)
    ; INVERTED: if NOT paused, jump over the long jump
    jnb paused_flag, OT_check_error
    ljmp OT_done               ; Long jump if paused
    
OT_check_error:
    jnb error_demo_flag, OT_continue
    ljmp OT_done               ; Long jump if error
    
OT_continue:
    ; ---- Now proceed with temperature reading ----
    mov ADC_C, #0x00
    Wait_Milli_Seconds(#2)
   
    lcall Get_ADC12_to_x
    Load_y(4806)
    lcall mul32
    mov y+0, volt_ref+0
    mov y+1, volt_ref+1
    mov y+2, #0
    mov y+3, #0
    lcall div32
    mov rm_temp+0, x+0
    mov rm_temp+1, x+1
    mov rm_temp+2, x+2
    mov rm_temp+3, x+3
    
    ; ----------------------------
    ; OVEN: ADC ch1 -> x (scaled)
    ; ----------------------------
    mov ADC_C, #0x01
    Wait_Milli_Seconds(#2)
    lcall Get_ADC12_to_x
    Load_y(4806)
    lcall mul32
    mov y+0, volt_ref+0
    mov y+1, volt_ref+1
    mov y+2, #0
    mov y+3, #0
    lcall div32
    
    ; ---- BEGIN your calibrated oven math block ----
    Load_y(1000000)
    lcall mul32
    Load_y(41)
    lcall div32
    Load_y(302781)
    lcall div32
    Load_y(12143)
    lcall mul32
    Load_y(8225)
    lcall add32
    Load_y(10000)
    lcall div32
    Load_y(3)
    lcall sub32
    
    ; Add (room_temp / 100) to oven result
    mov y+0, rm_temp+0
    mov y+1, rm_temp+1
    mov y+2, rm_temp+2
    mov y+3, rm_temp+3
    push x+0
    push x+1
    push x+2
    push x+3
    mov x+0, y+0
    mov x+1, y+1
    mov x+2, y+2
    mov x+3, y+3
    Load_y(100)
    lcall div32
    mov y+0, x+0
    mov y+1, x+1
    mov y+2, x+2
    mov y+3, x+3
    pop x+3
    pop x+2
    pop x+1
    pop x+0
    lcall add32
    ; ---- END your calibrated oven math block ----
    
    mov ov_temp+0, x+0
    mov ov_temp+1, x+1
    mov ov_temp+2, x+2
    mov ov_temp+3, x+3
    
    ; store final integer Celsius used everywhere
    mov oven_temp+0, x+0
    mov oven_temp+1, x+1

OT_done:
    ret

