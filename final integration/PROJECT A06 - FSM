;=========================================================
; RunTime printing " t:xyz"
;=========================================================
RunTime_To_3Digits:
    mov tmp16+0, run_time+0
    mov tmp16+1, run_time+1

    clr a
    mov R4,a
    mov R5,a
    mov R6,a

RT_h:
    mov target16+0,#100
    mov target16+1,#0
    lcall GE16
    jnc RT_t
    mov a,tmp16+0
    clr c
    subb a,#100
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R4
    sjmp RT_h

RT_t:
    mov target16+0,#10
    mov target16+1,#0
    lcall GE16
    jnc RT_u
    mov a,tmp16+0
    clr c
    subb a,#10
    mov tmp16+0,a
    mov a,tmp16+1
    subb a,#0
    mov tmp16+1,a
    inc R5
    sjmp RT_t

RT_u:
    mov R6,tmp16+0
    ret

LCD_ShowTempLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#temp_lbl)

    lcall Bin16_To_3Digits
    mov a, R0
    lcall WriteDigitA
    mov a, R1
    lcall WriteDigitA
    mov a, R2
    lcall WriteDigitA

    Send_Constant_String(#time_lbl)
    lcall RunTime_To_3Digits
    mov a, R4
    lcall WriteDigitA
    mov a, R5
    lcall WriteDigitA
    mov a, R6
    lcall WriteDigitA
    ret

LCD_ShowDutyLine2:
    lcall LCD_ClearLine2
    Set_Cursor(2,1)
    Send_Constant_String(#duty_lbl)

    clr a
    mov R0,a
    mov R1,a
    mov R2,a
    mov a, PWM_duty
    cjne a,#100, DUT_not100
    mov R0,#1
    mov R1,#0
    mov R2,#0
    sjmp DUT_print
DUT_not100:
    mov b,#10
    div ab
    mov R1,a
    mov R2,b
    mov R0,#0
DUT_print:
    mov a,R0
    jnz DUT_pH
    WriteData(#' ')
    sjmp DUT_pT
DUT_pH:
    lcall WriteDigitA
DUT_pT:
    mov a,R1
    jnz DUT_pTshow
    mov a,R0
    jnz DUT_pTshow
    WriteData(#' ')
    sjmp DUT_pU
DUT_pTshow:
    mov a,R1
    lcall WriteDigitA
DUT_pU:
    mov a,R2
    lcall WriteDigitA
    Send_Constant_String(#pct_lbl)

    Send_Constant_String(#time_lbl)
    lcall RunTime_To_3Digits
    mov a, R4
    lcall WriteDigitA
    mov a, R5
    lcall WriteDigitA
    mov a, R6
    lcall WriteDigitA
    ret

Show_Error_Message:
    lcall LCD_Clear
    Set_Cursor(1,1)
    Send_Constant_String(#s_error)
    Set_Cursor(2,1)
    Send_Constant_String(#err_msg)
    ret

Display_Status_All:
    lcall HEX_Show_OvenTemp

    mov a, run_flag
    jnz DSA_show
    jb error_demo_flag, DSA_show
    mov a, state
    cjne a, #ERROR_STATE, DSA_done

DSA_show:
    lcall LCD_ShowStateTitle
    jb SW5, DSA_duty
    lcall LCD_ShowTempLine2
    sjmp DSA_done
DSA_duty:
    lcall LCD_ShowDutyLine2
DSA_done:
    ret

;=========================================================
; Return_To_Menu
;=========================================================
Return_To_Menu:
    mov run_flag,#0
    clr paused_flag
    mov state,#0
    clr error_demo_flag
    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    clr duty_mode
    mov param_index,#0
    lcall Set_PWM_Off
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

;=========================================================
; Handle_Key (one-shot)
;=========================================================
Handle_Key:
    mov a, R7

    ; running time reset key '1'
    cjne a, #KEY_TIME_RESET, HK0
    clr a
    mov run_time+0,a
    mov run_time+1,a
    ret
HK0:

    ; ERROR (B): 10 beeps total (handled by Do_ExtraBeeps)
	cjne a, #KEY_ERR_BTN, HK_chk_stop
	setb error_demo_flag
	mov state,#ERROR_STATE
	mov run_flag,#0
	clr paused_flag
	lcall Set_PWM_Off
	lcall Show_Error_Message

	mov prev_state, #ERROR_STATE   ; prevent state-change beep
	mov beep_count,#10             ; exactly 10 beeps
	ret

HK_chk_stop:
    ; STOP (C): pauses if running
    cjne a, #KEY_STOP_BTN, HK_chk_start

    mov a, run_flag
    jz  HK_stop_exit_near
    jb  paused_flag, HK_stop_exit_near

    setb paused_flag
    lcall Set_PWM_Off
    ret

HK_stop_exit_near:
    ljmp HK_done

HK_chk_start:
    ; START (D): resume if paused, else toggle run
    cjne a, #KEY_START_BTN, HK_not_control

    jb error_demo_flag, HK_clear_err_to_menu
    jb paused_flag, HK_resume
    sjmp HK_toggle_run

HK_resume:
    clr paused_flag
    ret

HK_clear_err_to_menu:
    lcall Return_To_Menu
    ret

HK_toggle_run:
    mov a, run_flag
    xrl a, #1
    mov run_flag, a

    jz HK_stopped
    mov state, #1
    clr a
    mov seconds+0,a
    mov seconds+1,a
    mov reflow_done_flag,#0
    mov reflow_beeped,#0
    mov temp_stall_secs,#0
    clr paused_flag
    lcall LCD_Clear
    ret

HK_stopped:
    mov state,#0
    clr paused_flag
    lcall Set_PWM_Off
    ret

HK_not_control:
    mov a, run_flag
    jnz HK_done
    jb paused_flag, HK_done
    jb error_demo_flag, HK_done

    ; ENTER (*)
    mov a, R7
    cjne a, #KEY_STAR, HK_clear
    jb duty_mode, HK_save_duty

    lcall Save_Param
    mov a, param_index
    cjne a, #4, HK_inc
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_inc:
    inc param_index
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_save_duty:
    lcall Save_Duty
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    ret

HK_clear:
    mov a, R7
    cjne a, #KEY_POUND, HK_digit
    lcall Clear_Input
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_digit:
    mov a, R7
    cjne a, #0Ah, HK_maybe
    ret
HK_maybe:
    jc HK_ok
    ret
HK_ok:
    clr blank_flag
    lcall Shift_Digits_Left
    lcall LCD_ShowInput
    lcall HEX_ShowInput
    ret

HK_done:
    ret

;=========================================================
; MAIN
;=========================================================
main:
    mov SP,#7Fh

    mov P0MOD,#10101111b
    mov P1MOD,#10100010b
    mov P2MOD,#10000010b
    setb P1.5
    mov lcd_div, #0
    mov a, LEDRA
    clr a
    mov LEDRA, a
    setb LEDRA.5

    clr a
    mov param_index,a
    clr duty_mode

    mov state,#0
    mov prev_state,#0
    mov run_flag,#0

    mov error_flag,#0
    mov beep_count,#0
    mov temp_stall_secs,#0
    mov reflow_done_flag,#0
    mov reflow_beeped,#0

    clr paused_flag
    clr error_demo_flag

    mov key_lock,#0
    mov last_key,#0

    ; temps defaults
    mov oven_temp+0,#25
    mov oven_temp+1,#0
    mov last_temp_L,#25
    mov last_temp_H,#0

    ; time
    clr a
    mov run_time+0,a
    mov run_time+1,a
    mov seconds+0,a
    mov seconds+1,a

    lcall Clear_Input
    lcall Configure_Keypad_Pins

    ; timers
    lcall Timer0_Init
    lcall Timer1_Init

    ; UART baud on Timer2
    lcall InitSerialPort

    ; read volt_ref once (ADC ch2)
    lcall Init_VoltRef

    setb PWM
    setb EA

    lcall LCD_4BIT
    lcall LCD_Update
    lcall HEX_ShowInput

loop:
    ; UI mode toggle (only when not running and not error screen)
    mov a, run_flag
    jnz SKIP_UI_MODE
    jb error_demo_flag, SKIP_UI_MODE

    jb SW5, SW5_ON
SW5_OFF:
    jb duty_mode, MODE_TO_PARAM
    sjmp SW5_DONE
MODE_TO_PARAM:
    clr duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput
    sjmp SW5_DONE

SW5_ON:
    jnb duty_mode, MODE_TO_DUTY
    sjmp SW5_DONE
MODE_TO_DUTY:
    setb duty_mode
    lcall Clear_Input
    lcall LCD_Update
    lcall HEX_ShowInput

SW5_DONE:
SKIP_UI_MODE:

    ; Keypad one-shot handling
    lcall Keypad
    jnc NO_KEY

    mov a, key_lock
    jz  PROCESS_KEY
    mov a, R7
    cjne a, last_key, PROCESS_KEY
    sjmp AFTER_KEY

PROCESS_KEY:
    mov key_lock,#1
    mov a,R7
    mov last_key,a
    lcall Handle_Key

AFTER_KEY:
    sjmp KEY_DONE

NO_KEY:
    mov key_lock,#0
KEY_DONE:

    ; If error screen active: after beeps finish, return to menu
    jb error_demo_flag, ERR_SCREEN
    sjmp RUN_NORMAL

ERR_SCREEN:
    lcall Do_ExtraBeeps
    mov a, beep_count
    jnz SHOW_ONLY
    lcall Return_To_Menu
SHOW_ONLY:
    lcall Display_Status_All
    sjmp loop

RUN_NORMAL:
    ; Temp update + stall + FSM + beeps + UART + display
    lcall OvenTemp_Update
    lcall Temp_Stall_Check
    lcall FSM_Control

    lcall Beep_On_State_Change
    lcall Do_ExtraBeeps

    ; UART prints SAME oven_temp that HEX shows
    lcall UART_Print_OvenTemp

    ; update LCD/HEX less often to avoid LCD lag
inc lcd_div
mov a, lcd_div
cjne a, #50, loop_skip_display   ; 50 loops ~ adjust as needed
mov lcd_div, #0
lcall Display_Status_All
loop_skip_display:
sjmp loop
    
    
    
    sjmp loop

END
