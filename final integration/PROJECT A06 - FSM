    sjmp LSI_done

LSI_2:
    Set_Cursor(1,VALUE_COL+1)
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA
    sjmp LSI_done

LSI_3:
    Set_Cursor(1,VALUE_COL)
    mov a,R0
    lcall WriteDigitA
    mov a,R1
    lcall WriteDigitA
    mov a,R2
    lcall WriteDigitA

LSI_done:
