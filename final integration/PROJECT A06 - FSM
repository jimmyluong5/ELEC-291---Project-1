;=========================================================
; REFLOW OVEN CONTROLLER (DE10-Lite CV-8052) - SINGLE FILE
; - Timer2 = UART baud (115200), NO ISR
; - Timer1 = 1kHz tick ISR + PWM
; - Timer0 = speaker tone
;
; IMPORTANT CHANGES (as requested):
;  1) OvenTemp_Update replaced with your calibrated ADC->temp math.
;     Final integer oven temperature is stored into oven_temp (16-bit).
;  2) HEX and UART BOTH display the same oven_temp variable.
;     - HEX_Show_OvenTemp reads oven_temp
;     - UART_Print_OvenTemp converts oven_temp via Bin16_To_3Digits
;  3) UART code fixed (no bad fall-through / label collisions).
;  4) volt_ref is read once at startup from ADC channel 2 (like your file).
;=========================================================

;=========================================================
; CLOCK + UART
;=========================================================
CLK            EQU 33333333
BAUD           EQU 115200
T2LOAD          EQU (65536-(CLK/(32*BAUD)))

;=========================================================
; TIMERS
;=========================================================
TIMER0_RATE     EQU 4096
TIMER0_RELOAD   EQU (65536-(CLK/(12*TIMER0_RATE)))

TIMER1_RATE     EQU 1000
TIMER1_RELOAD   EQU (65536-(CLK/(12*TIMER1_RATE)))

;=========================================================
; I/O
;=========================================================
SPEAKER         EQU P1.5
PWM             EQU P2.7

;=========================================================
; ADC SFRs (uncomment if your assembler complains)
;=========================================================
; ADC_C DATA 0A1h
; ADC_L DATA 0A2h
; ADC_H DATA 0A3h

;=========================================================
; KEYS (Read_keypad.inc mapping)
;=========================================================
KEY_STAR        EQU 0x0E      ; *
KEY_POUND       EQU 0x0F      ; #
KEY_ERR_BTN     EQU 0x0B      ; B (Row2 Col4)
KEY_STOP_BTN    EQU 0x0C      ; C (Row3 Col4)
KEY_START_BTN   EQU 0x0D      ; D (Row4 Col4)
KEY_TIME_RESET  EQU 0x0A      ; '1' clears running time

;=========================================================
; LCD + SWITCH
;=========================================================
VALUE_COL       EQU 11
SW5             EQU SWA.5

;=========================================================
; REFLOW / LIMITS
;=========================================================
LIQUIDUS        EQU 217
HOLD_DUTY       EQU 8
MAX_TEMP        EQU 250
STALL_LIMIT     EQU 60
SOAK_BAND       EQU 3      ; +/- 3°C window
SOAK_PULSE_DUTY EQU 10     ; heat pulses at 10%


;=========================================================
; STATES
;=========================================================
ERROR_STATE     EQU 6
COOL_STATE      EQU 5

;=========================================================
; VECTORS
;=========================================================
org 0x0000
    ljmp main

org 0x000B
    ljmp Timer0_ISR

org 0x001B
    ljmp Timer1_ISR

;=========================================================
; DATA
;=========================================================
dseg at 0x30

; math32 working registers
x:                  ds 4
y:                  ds 4

; PWM + tick
PWM_counter:        ds 1
PWM_duty:           ds 1

; keypad input digits
bcd:                ds 5
param_index:        ds 1

; profile parameters (packed BCD, 3 digits stored in 2 bytes)
soak_temp:          ds 2
soak_time:          ds 2
reflow_temp:        ds 2
reflow_time:        ds 2

; FSM + run control
state:              ds 1
run_flag:           ds 1

; timebase
ms_count:           ds 2
seconds:            ds 2
run_time:           ds 2

; temperature (FSM/HEX/UART uses this)
oven_temp:          ds 2          ; integer Celsius

; scratch / compare
tmp16:              ds 2
target16:           ds 2

; beeps
prev_state:         ds 1
beep_count:         ds 1

; stall detect
last_temp_L:        ds 1
last_temp_H:        ds 1
temp_stall_secs:    ds 1

; error / reflow
error_flag:         ds 1
reflow_done_flag:   ds 1
reflow_beeped:      ds 1
lcd_div: ds 1 
; keypad one-shot
key_lock:           ds 1
last_key:           ds 1

; ====== NEW: vars needed by your calibrated temperature pipeline ======
rm_temp:            ds 4
ov_temp:            ds 4
volt_ref:           ds 2

;=========================================================
; BIT FLAGS
;=========================================================
bseg
blank_flag:      dbit 1
duty_mode:       dbit 1
paused_flag:     dbit 1
error_demo_flag: dbit 1
mf:              dbit 1

cseg

;=========================================================
; LCD WIRING
;=========================================================
LCD_RS equ P0.0
LCD_E  equ P0.2
LCD_D4 equ P0.7
LCD_D5 equ P0.5
LCD_D6 equ P0.3
LCD_D7 equ P0.1

