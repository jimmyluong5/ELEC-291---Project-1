$MODMAX10

; The Special Function Registers below were added to 'MODMAX10' recently.
; If you are getting an error, uncomment the three lines below.

; ADC_C DATA 0xa1
; ADC_L DATA 0xa2
; ADC_H DATA 0xa3

	CSEG at 0
	ljmp mycode

dseg at 30h

x:		ds	4
y:		ds	4
bcd:	ds	5
rm_temp: ds 4
ov_temp: ds 4
volt_ref: ds 2

bseg

mf:		dbit 1

FREQ   EQU 33333333
BAUD   EQU 115200
T2LOAD EQU 65536-(FREQ/(32*BAUD))

CSEG

InitSerialPort:
	; Configure serial port and baud rate
	clr TR2 ; Disable timer 2
	mov T2CON, #30H ; RCLK=1, TCLK=1 
	mov RCAP2H, #high(T2LOAD)  
	mov RCAP2L, #low(T2LOAD)
	setb TR2 ; Enable timer 2
	mov SCON, #52H
	ret

putchar:
    JNB TI, putchar
    CLR TI
    MOV SBUF, a
    RET

SendString:
    CLR A
    MOVC A, @A+DPTR
    JZ SSDone
    LCALL putchar
    INC DPTR
    SJMP SendString
SSDone:
    ret

$include(math32.asm)

cseg
; These 'equ' must match the wiring between the DE10Lite board and the LCD!
; P0 is in connector JPIO.  Check "CV-8052 Soft Processor in the DE10Lite Board: Getting
; Started Guide" for the details.
LCD_RS equ P0.0   ; instead of 1.7
; ELCD_RW equ Px.x ; Not used.  Connected to ground 
LCD_E  equ P0.2 ; instead of 1.1
LCD_D4 equ P0.7
LCD_D5 equ P0.5
LCD_D6 equ P0.3
LCD_D7 equ P0.1



$NOLIST
$include(LCD_4bit_DE10Lite_no_RW.inc) ; A library of LCD related functions and utility macros
$LIST

; Look-up table for 7-seg displays
myLUT:
    DB 0xC0, 0xF9, 0xA4, 0xB0, 0x99        ; 0 TO 4
    DB 0x92, 0x82, 0xF8, 0x80, 0x90        ; 4 TO 9
    DB 0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E  ; A to F

Wait50ms:
;33.33MHz, 1 clk per cycle: 0.03us
	mov R0, #30
Wait50ms_L3:
	mov R1, #74
Wait50ms_L2:
	mov R2, #250
Wait50ms_L1:
	djnz R2, Wait50ms_L1 ;3*250*0.03us=22.5us
    djnz R1, Wait50ms_L2 ;74*22.5us=1.665ms
    djnz R0, Wait50ms_L3 ;1.665ms*30=50ms
    ret

Display_Voltage_7seg:
	
	mov dptr, #myLUT

	mov a, bcd+1
	swap a
	anl a, #0FH
	movc a, @a+dptr
	mov HEX5, a
	
	mov a, bcd+1
	anl a, #0FH
	movc a, @a+dptr
	anl a, #0x7f ; Turn on decimal point
	mov HEX4, a

	mov a, bcd+0
	swap a
	anl a, #0FH
	movc a, @a+dptr
	mov HEX3, a
	
	mov a, bcd+0
	anl a, #0FH
	movc a, @a+dptr
	mov HEX2 , a 
	
	ret

Display_Voltage_LCD:
Set_Cursor(1,12)
Display_BCD(bcd+1)
Display_char(#'.')
Display_BCD(bcd+0)
ret
	
Display_Voltage_Serial:
	mov a, bcd+1
	swap a
	anl a, #0FH
	orl a, #'0'
	lcall putchar
	
	mov a, #'.'
	lcall putchar
	
	mov a, bcd+1
	anl a, #0FH
	orl a, #'0'
	lcall putchar

	mov a, bcd+0
	swap a
	anl a, #0FH
	orl a, #'0'
	lcall putchar
	
	mov a, bcd+0
	anl a, #0FH
	orl a, #'0'
	lcall putchar

	mov a, #'\r'
	lcall putchar
	mov a, #'\n'
	lcall putchar
	ret
	
	
	
Display_Room_Temp:
Set_Cursor(1, 12)
Load_y(27315)
lcall sub32
mov rm_temp+0, x+0
mov rm_temp+1, x+1
mov rm_temp+2, x+2
mov rm_temp+3, x+3
lcall hex2bcd
Display_BCD(bcd+1)
Display_char(#'.')
Display_BCD(bcd+0)
ret
	
Display_Oven_Temp:
Load_y(1000000)
lcall mul32
Load_y(41) ;was 41
lcall div32
Load_y(302781)
lcall div32 ;still need to add rm temp
; scaling function
Load_y(12143) ; 12143 should also work, probably.
lcall mul32
Load_y(8225)
lcall add32
Load_y(10000)
lcall div32


; --- Prepare Room Temp for addition ---
; We need to move rm_temp to Y and divide by 10 to strip the decimal
mov y+0, rm_temp+0
mov y+1, rm_temp+1
mov y+2, rm_temp+2
mov y+3, rm_temp+3

push x+0         ; Save Oven Temp lower bytes on stack
push x+1         ; because div32 uses the X register
push x+2
push x+3

; Move Y (rm_temp) into X to divide it
mov x+0, y+0
mov x+1, y+1
mov x+2, y+2
mov x+3, y+3


Load_y(100)       ; Divide by 10 to turn 254 into 25
lcall div32

; Move the integer room temp into Y
mov y+0, x+0
mov y+1, x+1
mov y+2, x+2
mov y+3, x+3

pop x+3          ; Restore Oven Temp back to X
pop x+2
pop x+1
pop x+0

lcall add32      ; Now adding Oven(150) + Room(25) = 175

;Load_y(12) ;Software correction for oven offset
;lcall sub32

mov ov_temp+0, x+0
mov ov_temp+1, x+1
mov ov_temp+2, x+2
mov ov_temp+3, x+3

lcall hex2bcd

; Display Logic
Set_Cursor(2, 13)
Display_BCD(bcd+1)
Display_BCD(bcd+0)
;Set_Cursor(2,13)
;Display_char(#':')
Set_Cursor(2,16)
ret


;get the adc value
get_adc:
	mov x+3, #0
	mov x+2, #0
	mov x+1, ADC_H
	mov x+0, ADC_L
	ret
		
;           		1234567890123456    <- This helps determine the location of the counter
rm_temp_str:  db 	'Rm Temp(C):    ', 0
ov_temp_str: db		'Oven Temp(C):  ', 0
mycode:
	mov SP, #7FH
	clr a
	mov LEDRA, a
	mov LEDRB, a
	setb LEDRA.0
	
	
	
	lcall InitSerialPort
	
	; COnfigure the pins connected to the LCD as outputs
	mov P0MOD, #10101111b ; P0.1, P0.3, P0.5, P0.7 are outputs.  ('1' makes the pin output)
    mov P1MOD, #10000010b ; P1.7 and P1.1 are outputs

    lcall LCD_4BIT ; Configure LCD in four bit mode
    ; For convenience a few handy macros are included in 'LCD_4bit_DE1Lite.inc':
	Set_Cursor(1, 1)
    Send_Constant_String(#rm_temp_str)
    Set_Cursor(2,1)
    Send_Constant_String(#ov_temp_str)
	
	mov ADC_C, #0x80 ; Reset ADC
	lcall Wait50ms

forever:
	;mov a,SWA ; The first three switches select the channel to read
	;anl a, #0x07
	mov ADC_C, #0x2
	lcall get_adc
	mov volt_ref+0, x+0
	mov volt_ref+1, x+1
	
	Load_y(4806)
	lcall mul32
	
	mov y+0, volt_ref+0
	mov y+1, volt_ref+1
	mov y+2, #0
	mov y+3, #0
	lcall div32
	
	mov ADC_C, #0x0
	; Load 32-bit 'x' with 12-bit adc result
	lcall get_adc
	
	mov rm_temp+0, x+0
	mov rm_temp+1, x+1
	mov rm_temp+2, x+2
	mov rm_temp+3, x+3
	
	lcall hex2bcd
	lcall Display_Voltage_LCD
	;lcall bcd2hex
	mov ADC_C, #0x1
	lcall get_adc
	
	;lcall Display_Voltage_Serial
	lcall Display_Oven_Temp
	lcall Display_Voltage_7seg
	lcall Wait50ms
	lcall Wait50ms
	ljmp forever
	
end
